'' =================================================================================================
''
''   File....... isp_hub75_morphCounters.spin2
''   Purpose.... Manage groups of morphing 7-segment digits
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2021 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Jan 2021
''   Updated.... 12 Oct 2026
''   Version.... v1.0.0
''
'' =================================================================================================

CON ' library version -- values are written by tools/stamp_version.sh, never edit by hand

    MORPH_VERSION = 10000     ' MAJOR * 10000 + MINOR * 100 + PATCH, e.g. v1.2.3 is 10203

CON { public control values }

    DIGIT_NO_VALUE = -2   ' digit value when NOT [0-9]
    DIGIT_HIDDEN = -1     ' digit value when NOT [0-9]

    WITH_WRAP = TRUE
    WITHOUT_WRAP = FALSE

CON ' motion and cadence settings of a group

    MIN_MOVE_MS = 1                 ' a move lasts at least 1 ms (animate() divides by the duration)
    MIN_HOLD_MS = 0                 ' no hold: the next value may start on the frame after a transition completes
    MAX_TIME_MS = 86_400_000        ' one day, the longest move or hold accepted: times are compared by subtraction,
                                    '   which is right for spans under 24.8 days (isp_hub75_morphTime)
    DEFAULT_HOLD_MS = 200           ' hold after each transition when the caller sets none: the 2021 demo held 8 to 10
                                    '   loop passes, 178 to 222 ms (Docs/analysis/morph-time-design.md section d)

CON { Display constants }

#0, GRP_UNKNOWN, GRP_CLOCK, GRP_UP_COUNTER, GRP_DOWN_COUNTER, GRP_DIGITS, GRP_DIGITS_RANDOM

MAX_DIGITS = 6
LAST_DIGIT = MAX_DIGITS - 1         ' index of the last digit slot (digits[] runs from 0)

GAP_LARGE_DIGITS = 4

OBJ { Objects we use }

    pixels              : "isp_hub75_screenUtils"
    digits[MAX_DIGITS]  : "isp_hub75_morph7seg"
    timeBase            : "isp_hub75_morphTime"     ' motion constants only: DEFAULT_MOVE_MS and the EASE_ styles
    morphStatus         : "isp_hub75_morphStatus"   ' the status codes the setters return (a refused call changes nothing, spec R-10.2)

VAR { instance variable }

    long    numberDigits
    long    groupType
    long    currValue
    long    valueCap
    long    maxValueDivisor
    long    chainIndex

    ' calc values
    long    digitHeight
    long    digitWidth
    long    segmentThickness
    long    digitHspace

    ' display delay times
    long    digitVal

    ' variables when CLOCK is type
    long    hours
    long    hours24
    long    minutes
    long    dotRow
    long    dotCol
    long    dotVOffset

    long    initValue[MAX_DIGITS]

    ' time-based motion and cadence
    long    moveDurationMs      ' every segment move of the group takes this long, in ms
    long    moveEaseStyle       ' timeBase.EASE_LINEAR or timeBase.EASE_SMOOTH
    long    holdDurationMs      ' the group holds a value this long after its transition completes, in ms
    long    holdStartMs         ' nowMs of the animate() that saw the transition complete
    long    bHoldRunning        ' TRUE from that animate() until nextTimeCycle() starts the next value

    ' flags
    byte    showSecondIndicator
    byte    isSetup

PUB null()
    '' This is NOT a top level object

PUB versionString() : pVersion
    '' Return the address of the zero-terminated library version text, e.g. "v1.0.0"
    pVersion := @"v1.0.0"     ' MORPH_VERSION_STR -- written by tools/stamp_version.sh

PUB initialize(nChainIndex, nPhysicalRows, nPhysicalColumns) | digitIndex
    '' init this opbject so it knows nothing but knows it knows nothing ;-)
    isSetup := FALSE
    groupType := GRP_UNKNOWN
    chainIndex := nChainIndex
    repeat digitIndex from 0 to MAX_DIGITS -1
        digits[digitIndex].initialize(nChainIndex, nPhysicalRows, nPhysicalColumns)
    ' the segments default to the same motion when they are initialized
    moveDurationMs := timeBase.DEFAULT_MOVE_MS
    moveEaseStyle := timeBase.EASE_LINEAR
    holdDurationMs := DEFAULT_HOLD_MS
    bHoldRunning := FALSE

PUB placeDigitGroup(row, column, grpType, nbrDigits, segThickness, segLength, initialValue, rgbColor) : grpWidth, grpHeight | currCol, digitIdx
    '' Locate a desired digit group on our screen. Draw initial segements if {initialValue} is NOT off
    digitHspace := (segLength > 7) ? GAP_LARGE_DIGITS : 1
    groupType := grpType
    numberDigits := nbrDigits
    currValue := initialValue
    valueCap := 1
    repeat nbrDigits
        valueCap := valueCap * 10
    maxValueDivisor := valueCap / 10    ' e.g., if we are 3 digits then maxDiv is 100
    valueCap := valueCap - 1
    debug("mG:placeDigit rc=(", udec_(row), ",", udec_(column), ") ", udec(grpType), udec(nbrDigits), udec(initialValue), udec(valueCap), ", RGB=(", uhex_long_(rgbColor),")")

    ensureIsSetup()

    digitWidth, digitHeight, segmentThickness := calcDigitSizeFmSegLength(segLength, segThickness)
    'debug("* Seg-len 5,2: ", udec_long(digitWidth), udec_long(digitHeight))

    grpWidth := (digitWidth + digitHspace) * nbrDigits
    if groupType == GRP_CLOCK
        grpWidth := grpWidth + 2 + 1    ' add-in width of dots
        dotRow := row + (segLength / 2)
        dotCol := column + (digitWidth + digitHspace) * 2
        dotVOffset := segLength + 1
    grpHeight := digitHeight + 1

    if groupType == GRP_CLOCK
        hours := currValue / 60
        minutes := currValue // 60
        initValue[0] := hours / 10
        initValue[1] := hours // 10
        initValue[2] := minutes / 10
        initValue[3] := minutes // 10
        showSecondIndicator := TRUE
    else
        updateInitsFromValue(currValue)

    currCol := column
    repeat digitIdx from 0 to nbrDigits - 1
        ' FIXME; UNDONE calculate initial values (mod 10!) - all decimal
        digits[digitIdx].placeDigit(row, currCol, digitWidth, digitHeight, initValue[digitIdx], rgbColor)
        currCol := currCol + digitWidth + digitHspace
        if groupType == GRP_CLOCK && digitIdx == 1
            currCol := currCol + 2 + 1  ' add in dot width

    if groupType == GRP_CLOCK
        showSecondsDots( 0 )

PUB setMoveDuration(durationMs) : status
'' Set how long every segment move of this group takes: the same real time for every segment length (spec R-5.4).
''
'' @param durationMs - Duration of each move in ms, MIN_MOVE_MS to MAX_TIME_MS (timeBase.DEFAULT_MOVE_MS when never set); a move in flight follows it from the next animate()
'' @returns status - morphStatus.SUCCESS, or morphStatus.E_OUT_OF_RANGE with nothing changed

    status := morphStatus.E_OUT_OF_RANGE
    if durationMs >= MIN_MOVE_MS && durationMs <= MAX_TIME_MS
        moveDurationMs := durationMs
        applyMotion()
        status := morphStatus.SUCCESS

PUB setHoldDuration(holdMs) : status
'' Set how long this group holds each value after its transition completes, before isHoldComplete() reports TRUE.
''
'' @param holdMs - Hold in ms, MIN_HOLD_MS to MAX_TIME_MS (DEFAULT_HOLD_MS when never set)
'' @returns status - morphStatus.SUCCESS, or morphStatus.E_OUT_OF_RANGE with nothing changed

    status := morphStatus.E_OUT_OF_RANGE
    if holdMs >= MIN_HOLD_MS && holdMs <= MAX_TIME_MS
        holdDurationMs := holdMs
        status := morphStatus.SUCCESS

PUB setEasing(easeStyle) : status
'' Set how the position of every segment move of this group follows its time.
''
'' @param easeStyle - Easing style, timeBase.EASE_LINEAR (constant speed, used when never set) or timeBase.EASE_SMOOTH (slow start and end)
'' @returns status - morphStatus.SUCCESS, or morphStatus.E_UNKNOWN_EASING with nothing changed

    status := morphStatus.E_UNKNOWN_EASING
    if easeStyle == timeBase.EASE_LINEAR || easeStyle == timeBase.EASE_SMOOTH
        moveEaseStyle := easeStyle
        applyMotion()
        status := morphStatus.SUCCESS

PUB isAnimationComplete() : bComplete | digitIdx
'' Return TRUE when no segment of this group is moving. A pure query: asking does not change the answer.
''
'' @returns bComplete - TRUE when every digit of the group has finished its moves

' Local Variables:
' @local digitIdx - Index of the digit being asked

    bComplete := TRUE
    repeat digitIdx from 0 to LAST_DIGIT
        if not digits[digitIdx].isAnimationComplete()
            bComplete := FALSE
            quit

PUB animate(nowMs) : movingCount | digitIdx
'' Draw every moving segment of this group at its position for time nowMs, and start the hold when the transition completes.
''
'' @param nowMs - The frame's time in ms, from isp_hub75_morphTime.update(): the same value for every group, digit and segment of a frame
'' @returns movingCount - Number of this group's segments still moving after this call; 0 when the transition is complete

' Local Variables:
' @local digitIdx - Index of the digit being drawn

    movingCount := 0
    if numberDigits > 0             ' only the digits this group uses; an unused digit never moves
        repeat digitIdx from 0 to numberDigits - 1
            movingCount += digits[digitIdx].animate(nowMs)
    if movingCount == 0 && bHoldRunning == FALSE     ' this pass drew the last of the transition: start the hold
        holdStartMs := nowMs
        bHoldRunning := TRUE

PUB isHoldComplete(nowMs) : bHoldDone
'' Return TRUE when this group's transition has completed and its hold has passed, so the caller may start the next value.
''
'' @param nowMs - The frame's time in ms, from isp_hub75_morphTime.update(): the same value for every group, digit and segment of a frame
'' @returns bHoldDone - TRUE once the hold duration has passed since animate() saw the transition complete

    bHoldDone := FALSE
    if bHoldRunning == TRUE
        bHoldDone := (nowMs - holdStartMs) >= holdDurationMs          ' times compared by subtraction: wrap-safe

PRI updateInitsFromValue(desiredValue) | currDivisor, digitIdx, digitValue, remainingValue
    currDivisor := maxValueDivisor
    remainingValue := desiredValue
    repeat digitIdx from numberDigits - 1 to 0
        digitValue := remainingValue / currDivisor
        remainingValue -= digitValue * currDivisor
        initValue[(numberDigits - 1) - digitIdx] := digitValue
        if currDivisor == 1     ' safety, should never happen
            quit
        currDivisor /= 10

PRI ensureIsSetup()
    ' Do intial setup, if not yet done
    if not isSetup
        initialSetup()

PRI initialSetup() | byte segIndex, orientation, segRow, segCol, segW, segL
    ' Perform initial setup
    isSetup := TRUE
    hours24 := hours := minutes := 0
    showSecondIndicator := FALSE
    if groupType == GRP_CLOCK
        showSecondIndicator := TRUE

PUB isConfigured() : bStatus
    '' return T/F were T means this counter is active
    bStatus := (groupType <> GRP_UNKNOWN)

PUB nextTimeCycle() | bShowCurrValue
    '' step this counter by one
    'debug("mG:-nxTimCyc(", udec_(groupType), ")")
    bHoldRunning := FALSE       ' a new transition: animate() starts the next hold when it completes
    bShowCurrValue := TRUE
    case groupType
        GRP_CLOCK:
            currValue := currValue + 1
            if currValue > 1259
                currValue := 0
            hours := currValue / 60
            minutes := currValue // 60
            bShowCurrValue := FALSE ' nope, were doing that next
            updateDigitsFromTime(hours, minutes)
        GRP_UP_COUNTER:
            currValue := currValue + 1
            if currValue > valueCap
                currValue := 0
        GRP_DOWN_COUNTER:
            currValue := currValue - 1
            if currValue < 0
                currValue := valueCap
        GRP_DIGITS:
            ' nothing here value is set from outside
        GRP_DIGITS_RANDOM:
            currValue := getrnd()
            if currValue < 0
                currValue := 0 - currValue
            if currValue > valueCap
                currValue //= (valueCap + 1)
        other:
            debug("- BAD Group Type")
            abort

    if bShowCurrValue
        updateDigitsFromValue(currValue)

PRI updateDigitsFromTime(timeHours, timeMinutes)
    digits[0].setValue(timeHours / 10)
    digits[1].setValue(timeHours // 10)
    digits[2].setValue(timeMinutes / 10)
    digits[3].setValue(timeMinutes // 10)
    showSecondsDots( timeMinutes // 4 )

PRI updateDigitsFromValue(desiredValue) | currDivisor, digitIdx, digitValue, remainingValue
    currDivisor := maxValueDivisor
    remainingValue := desiredValue
    'debug("mG: ", udec(remainingValue), udec(currDivisor), udec(valueCap))
    repeat digitIdx from numberDigits - 1 to 0
        digitValue := remainingValue / currDivisor
        remainingValue -= digitValue * currDivisor
        'debug("mG:  ", udec(digitValue), udec(remainingValue))
        digits[(numberDigits - 1) - digitIdx].setValue(digitValue)
        if currDivisor >= 10     ' safety, should never happen
            currDivisor /= 10
        'debug("mG:  ", udec(currDivisor))

    'repeat ' stop to eval debug

PRI applyMotion() | digitIdx
' Hand the group's move duration and easing to every digit (and so to every segment).

' Local Variables:
' @local digitIdx - Index of the digit being set

    repeat digitIdx from 0 to LAST_DIGIT
        digits[digitIdx].setMotion(moveDurationMs, moveEaseStyle)

PRI calcDigitSizeFmSegLength(segmentLength, segmentWidth) : digWidth, digHeight, segWidth
    ' FIXME: UNDONE assumes segmentWidth of 1
    segWidth := segmentWidth
    digWidth := segmentLength + (2 * segmentWidth)
    digHeight := (segmentLength * 2) + (3 * segmentWidth)

PRI showSecondsDots(lightDark) | red, green, blue, targetColor
   ' lightDarkv[0,1] where 1 means bright color
    if lightDark & 1 > 0    ' > 0 is 1/4 ON  -  & 1 > 0  is 1/2 ON
        targetColor := $00006F
    else
        targetColor := $0080FF

    drawSecondsDot(dotRow, dotCol, targetColor)
    drawSecondsDot(dotRow + dotVOffset, dotCol, targetColor)

PRI drawSecondsDot(row, column, rgbColor)
    'place a dot on the screen
    pixels.drawPixelAtRC(chainIndex, row, column, rgbColor)
    pixels.drawPixelAtRC(chainIndex, row, column+1, rgbColor)
    pixels.drawPixelAtRC(chainIndex, row+1, column, rgbColor)
    pixels.drawPixelAtRC(chainIndex, row+1, column+1, rgbColor)


CON { license }

