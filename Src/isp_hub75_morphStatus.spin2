'' =================================================================================================

{ Every placement and setter call returns SUCCESS (0) or one of the negative codes below (spec R-10.1),
  and a refused call changes nothing: not the display, not the object's state (R-10.2).

  The codes live in this one file so that no two objects can give one value two meanings: an object
  that returns a code includes this file, and so does a program that checks one:

    OBJ
        morphStatus : "isp_hub75_morphStatus"
    ...
        if group.setEasing(style) <> morphStatus.SUCCESS
}

CON ' status codes (a new code takes the next unused negative value; a value is never reused)

  SUCCESS = 0
  E_OUT_OF_RANGE = -1                                           ' a move or hold duration outside isp_hub75_morphCounters' MIN_MOVE_MS / MIN_HOLD_MS to MAX_TIME_MS
  E_UNKNOWN_EASING = -2                                         ' an easing style that is not isp_hub75_morphTime's EASE_LINEAR or EASE_SMOOTH
  E_BAD_THICKNESS = -3                                          ' a segment thickness below 1 pixel
  E_THICKNESS_TOO_LARGE = -4                                    ' a segment thickness greater than the segment's length
  E_UNKNOWN_END_STYLE = -5                                      ' an end style that is not isp_hub75_morphMask's END_SQUARE or END_ANGLED
  E_UNKNOWN_CROSS_SECTION = -6                                  ' a cross-section that is not isp_hub75_morphMask's SECTION_FLAT or SECTION_TUBE
  E_MASK_TOO_LARGE = -7                                         ' a segment mask that needs more bytes than the buffer given for it
  E_UNKNOWN_PROFILE = -8                                        ' a motion profile that is not isp_hub75_morphTime's PROFILE_EDGE or PROFILE_TAIL
  E_BAD_TAIL_LENGTH = -9                                        ' a tail shorter than isp_hub75_morphTime's MIN_TAIL_PIXELS
  E_BAD_COMMAND = -10                                           ' a segment command byte whose style is unknown or not one this segment can do
  E_UNKNOWN_ROTATION = -11                                      ' a rotation that is not isp_hub75_morphCounters' ROT_0, ROT_90, ROT_180 or ROT_270

PUB null()
'' This is not a top level object
''

CON ' license

