'' =================================================================================================
''
''   File....... isp_hub75_morphSegment.spin2
''   Purpose.... The motion of one morphing segment: on/off state, snake head or column slide, at the frame's time
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2021 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Jan 2021
''   Updated.... 12 Oct 2026
''   Version.... v1.0.0
''
'' =================================================================================================

{ A segment knows how it is moving; it draws nothing. Its digit (isp_hub75_morph7seg) owns the
  geometry, reads renderState() once per frame, and draws every changed pixel of the digit at once,
  so segments that touch or overlap are composited correctly.

        A
      F   B
        G
      E   C
        D

  Motion, in 1/256 pixel along the segment (its mask's columns, from its start end):
    snake - the lit part grows (turning on) or shrinks (turning off) from one end. The head runs from
            0 to length + tail over the move; a column's lit share is the average, over that column, of
            clamp((head - x) / tail, 0, 1), so the tail is a gradient tail pixels long and a 1-pixel tail
            is an exactly anti-aliased edge (time-based profile, spec R-5.3).
    slide - the left verticals E and F move sideways as a whole column (CMD_COL_TO_RT / CMD_COL_TO_LT):
            turning on ends at home, turning off starts there; the far end is the opposite vertical.
  CMD_IMMEDIATE turns the segment on or off at once.
}

CON ' segment states, orientations and the command byte

' Segment Orientation Values
#0, SOR_UNKNOWN, #$40, SOR_TOP_A, #$20, SOR_RIGHT_B, #$10, SOR_RIGHT_C, #$08, SOR_BOTTOM_D, #$04, SOR_LEFT_E, #$02, SOR_LEFT_F, #$01, SOR_MIDDLE_G
' Segment State values
#0, STATE_UNKNOWN, STATE_TURNING_OFF, STATE_OFF, STATE_TURNING_ON, STATE_ON

' Command Flags %GGG-AAAT where: %GGGx_xxxx = segment, %xxxx_AAAx = style, %xxxx_xxxT = ON/OFF
'
#0, MASK_NOTHING, #$01, MASK_ONOFF, #$0E, MASK_STYLE, #$E0, MASK_SEGMENT
SEGMENT_ID_SHIFT = 5    ' MASK_SEGMENT's place: a command's segment ID minus 1 is its digit slot (G=0 .. A=6)

' - Segment ID values (used when commanding actions) - %GGGx_xxxx field values
#0, SEG_UNKNOWN, #$E0, SEG_TOP_A, #$C0, SEG_RIGHT_B, #$A0, SEG_RIGHT_C, #$80, SEG_BOTTOM_D, #$60, SEG_LEFT_E, #$40, SEG_LEFT_F, #$20, SEG_MIDDLE_G

' - turn ON/OFF - %xxxx_xxxT field values
#0, CMD_TURN_ON, #$01, CMD_TURN_OFF

' STYLE to use to when turning ON/OFF - %xxxx_AAAx field values
' %00000 CMD_UNKNOWN
' %00010 CMD_BOTTOM_UP
' %00100 CMD_TOP_DOWN
' %00110 CMD_LT_TO_RT
' %01000 CMD_RT_TO_LT
' %01010 CMD_COL_TO_RT
' %01100 CMD_COL_TO_LT
' %01110 CMD_IMMEDIATE
#0, CMD_UNKNOWN, #$02, CMD_BOTTOM_UP, #$04, CMD_TOP_DOWN, #$06, CMD_LT_TO_RT, #$08, CMD_RT_TO_LT, #$0A, CMD_COL_TO_RT, #$0C, CMD_COL_TO_LT, #$0E, CMD_IMMEDIATE

CON ' what the digit draws for this segment this frame (renderState())

  ' MODE_NONE  - nothing: the segment is off
  ' MODE_FULL  - the whole mask: the segment is on and still
  ' MODE_SNAKE - the mask times the snake's lit share per column (head, tail, from which end, on or off)
  ' MODE_SLIDE - the whole mask, moved sideways by the slide offset
  #0, MODE_NONE, MODE_FULL, MODE_SNAKE, MODE_SLIDE

CON ' time-based motion: integer fixed point, no floats per frame

  PROGRESS_ONE = 32768                                          ' Q15: a move's progress runs from 0 up to this value (the whole move)
  SUBPIXELS = 256                                               ' positions are in 1/SUBPIXELS pixel
  STILL_MOVING = 1                                              ' animate() returns this count while the segment's move is in progress, 0 once at rest
  SMOOTH_SQUARE_GAIN = 3                                        ' smoothstep 3p^2 - 2p^3: the factor of the p^2 term
  SMOOTH_CUBE_GAIN = 2                                          ' smoothstep 3p^2 - 2p^3: the factor of the p^3 term
  NO_OFFSET = 0                                                 ' a slide's home position

OBJ

    timeBase    : "isp_hub75_morphTime"                         ' motion constants only: DEFAULT_MOVE_MS and the EASE_ styles
    morphStatus : "isp_hub75_morphStatus"                       ' the status code commandSegment() returns

VAR

    ' placement
    long    segOrientation
    long    lengthX256          ' the segment's length along itself (its mask's columns), in 1/SUBPIXELS pixel
    long    slideX256           ' how far a column slide travels: to the opposite vertical, in 1/SUBPIXELS pixel
    long    tailX256            ' the snake's tail, in 1/SUBPIXELS pixel
    ' state
    long    currentState
    long    desiredEndState
    long    moveStyle           ' the command style of the move in flight (MASK_STYLE bits)
    long    bTurningOn          ' TRUE when the move in flight turns the segment on
    long    headX256            ' snake: the head's position along the segment, 0 to lengthX256 + tailX256
    long    offsetX256          ' slide: the column's offset from home (+ to the right)
    long    slideStartX256      ' slide: the offset at the start of the move ...
    long    slideEndX256        ' ... and at its end
    ' time-based motion: the position of a move follows (nowMs - moveStartMs) / moveDurationMs
    long    moveDurationMs      ' how long every move of this segment takes, in ms
    long    moveEaseStyle       ' timeBase.EASE_LINEAR or timeBase.EASE_SMOOTH
    long    moveStartMs         ' nowMs of the first animate() after the command (stamped there, lazily)
    long    bStartPending       ' TRUE from a command until the next animate() stamps moveStartMs

PUB null()
'' This is NOT a top level object
''

PUB initialize()
'' Reset this segment to off, with the default motion.
''

    currentState := desiredEndState := STATE_OFF
    moveDurationMs := timeBase.DEFAULT_MOVE_MS
    moveEaseStyle := timeBase.EASE_LINEAR

PUB placeSegment(orientation, segLengthX256, segSlideX256, segTailX256)
'' Set this segment's identity and sizes, and turn it off. Its digit has checked the sizes.
''
'' @param orientation - SOR_TOP_A .. SOR_MIDDLE_G
'' @param segLengthX256 - the segment's length along itself (its mask's columns), in 1/SUBPIXELS pixel
'' @param segSlideX256 - how far a column slide travels (E and F only), in 1/SUBPIXELS pixel
'' @param segTailX256 - the snake's tail, in 1/SUBPIXELS pixel (SUBPIXELS for PROFILE_EDGE)

    segOrientation := orientation
    lengthX256 := segLengthX256
    slideX256 := segSlideX256
    tailX256 := segTailX256
    currentState := desiredEndState := STATE_OFF

PUB setTail(segTailX256)
'' Set the snake's tail; a move in flight uses it from the next animate().
''
'' @param segTailX256 - the snake's tail, in 1/SUBPIXELS pixel (SUBPIXELS for PROFILE_EDGE)

    tailX256 := segTailX256

PUB setMotion(durationMs, easeStyle)
'' Set how this segment moves: the duration of every move and its easing; a move in flight follows them from the next animate().
''
'' @param durationMs - Duration of each move in ms; morphCounters.setMoveDuration() checks the range
'' @param easeStyle - Easing style, timeBase.EASE_LINEAR or timeBase.EASE_SMOOTH; morphCounters.setEasing() checks it

    moveDurationMs := durationMs
    moveEaseStyle := easeStyle

PUB commandSegment(commandBits) : status | style, bOn
'' Start a move of this segment; a move still in flight is first snapped to its end (spec R-5.5, R-5.7).
'' A command whose style this segment cannot do is refused: logged, nothing changed, nothing drawn.
''
'' @param commandBits - Command byte %GGG_AAAT: the style (MASK_STYLE) and on/off (MASK_ONOFF); the segment ID bits are not used here
'' @returns status - morphStatus.SUCCESS, or morphStatus.E_BAD_COMMAND with nothing changed

' Local Variables:
' @local style - the command's style (MASK_STYLE bits)
' @local bOn - TRUE when the command turns the segment on

    style := commandBits & MASK_STYLE
    bOn := (commandBits & MASK_ONOFF) == CMD_TURN_ON
    status := morphStatus.SUCCESS
    if not isStyleAllowed(style)
        status := morphStatus.E_BAD_COMMAND
        debug("mSG: refused command ", uhex_byte_(commandBits), " for segment ", uhex_byte_(segOrientation))
    else
        if not isMovementComplete()
            finishMove()
        if (bOn and currentState <> STATE_ON) or (not bOn and currentState <> STATE_OFF)
            moveStyle := style
            bTurningOn := bOn
            desiredEndState := bOn ? STATE_ON : STATE_OFF
            currentState := bOn ? STATE_TURNING_ON : STATE_TURNING_OFF
            headX256 := 0
            if style == CMD_COL_TO_RT or style == CMD_COL_TO_LT
                ' turning on ends at home, turning off starts there; the move goes the style's way
                slideEndX256 := (style == CMD_COL_TO_RT) ? slideX256 : -slideX256
                slideStartX256 := NO_OFFSET
                if bOn
                    slideStartX256 := -slideEndX256
                    slideEndX256 := NO_OFFSET
                offsetX256 := slideStartX256
            bStartPending := TRUE
            if style == CMD_IMMEDIATE
                finishMove()

PUB isMovementComplete() : bComplete
'' Return TRUE when this segment has no move in flight.
''
'' @returns bComplete - TRUE when the segment is at rest, on or off

    bComplete := (desiredEndState == currentState)

PUB animate(nowMs) : movingCount | moveElapsedMs, progress
'' Advance this segment's move to its position for time nowMs. Draws nothing: the digit reads renderState().
''
'' @param nowMs - The frame's time in ms, from isp_hub75_morphTime.update(): the same value for every group, digit and segment of a frame
'' @returns movingCount - 1 when the move is still in progress after this call, 0 when the segment is at rest

' Local Variables:
' @local moveElapsedMs - Time since the move's first animate(), in ms (0 on that call)
' @local progress - Share of the move done, Q15 (PROGRESS_ONE is the whole move), after easing

    if not isMovementComplete()
        if bStartPending
            moveStartMs := nowMs
            bStartPending := FALSE
        moveElapsedMs := (nowMs - moveStartMs) #> 0                     ' times compared by subtraction: wrap-safe
        if moveElapsedMs >= moveDurationMs
            finishMove()                                                ' a late frame lands on the end: motion never slows down (R-5.4)
        else
            progress := easedProgress(muldiv64(moveElapsedMs, PROGRESS_ONE, moveDurationMs))
            headX256 := muldiv64(progress, lengthX256 + tailX256, PROGRESS_ONE)
            offsetX256 := slideStartX256 + (slideEndX256 - slideStartX256) * progress / PROGRESS_ONE
    movingCount := 0
    if not isMovementComplete()
        movingCount := STILL_MOVING

PUB renderState() : mode, headPos, tailLen, bFromEnd, bOn, offsetPos
'' What the digit draws for this segment now (see MODE_ above).
''
'' @returns mode - MODE_NONE, MODE_FULL, MODE_SNAKE or MODE_SLIDE
'' @returns headPos - snake: the head's position from the start end, in 1/SUBPIXELS pixel
'' @returns tailLen - snake: the tail, in 1/SUBPIXELS pixel
'' @returns bFromEnd - snake: TRUE when it runs from the segment's far end (right or bottom)
'' @returns bOn - snake: TRUE when turning on (the lit part grows), FALSE when turning off
'' @returns offsetPos - slide: the column's offset from home, + to the right, in 1/SUBPIXELS pixel

    headPos := headX256
    tailLen := tailX256
    bOn := bTurningOn
    offsetPos := offsetX256
    bFromEnd := moveStyle == CMD_RT_TO_LT or moveStyle == CMD_BOTTOM_UP
    case currentState
        STATE_ON:
            mode := MODE_FULL
        STATE_OFF:
            mode := MODE_NONE
        other:
            mode := (moveStyle == CMD_COL_TO_RT or moveStyle == CMD_COL_TO_LT) ? MODE_SLIDE : MODE_SNAKE

PRI isStyleAllowed(style) : bAllowed
' TRUE when this segment can move in this style: horizontals snake left/right, verticals up/down,
' and only the left verticals E and F slide as a column. Every segment can turn on or off at once.

    case segOrientation
        SOR_TOP_A, SOR_MIDDLE_G, SOR_BOTTOM_D:
            bAllowed := style == CMD_LT_TO_RT or style == CMD_RT_TO_LT or style == CMD_IMMEDIATE
        SOR_RIGHT_B, SOR_RIGHT_C:
            bAllowed := style == CMD_TOP_DOWN or style == CMD_BOTTOM_UP or style == CMD_IMMEDIATE
        SOR_LEFT_E, SOR_LEFT_F:
            bAllowed := style == CMD_TOP_DOWN or style == CMD_BOTTOM_UP or style == CMD_COL_TO_RT or style == CMD_COL_TO_LT or style == CMD_IMMEDIATE
        other:
            bAllowed := FALSE

PRI easedProgress(linearProgress) : shapedProgress
' Shape a move's linear progress by this segment's easing style (Q15 in, Q15 out, integers only).
'
' @param linearProgress - Share of the move's time that has passed, 0 to PROGRESS_ONE - 1
' @returns shapedProgress - Share of the move's distance to draw, 0 to PROGRESS_ONE - 1

    shapedProgress := linearProgress
    if moveEaseStyle == timeBase.EASE_SMOOTH
        ' 3p^2 - 2p^3 as p^2 x (3 - 2p): p^2 is at most 2^30, the 64-bit product at most 1.1 x 10^14 (muldiv64 is unsigned)
        shapedProgress := muldiv64(linearProgress * linearProgress, SMOOTH_SQUARE_GAIN * PROGRESS_ONE - SMOOTH_CUBE_GAIN * linearProgress, PROGRESS_ONE * PROGRESS_ONE)

PRI finishMove()
' End the move in flight: the segment is fully on or fully off. Shared by a snap (commandSegment) and a move's end (animate).

    currentState := desiredEndState
    headX256 := lengthX256 + tailX256
    offsetX256 := NO_OFFSET
    bStartPending := FALSE

CON ' license

