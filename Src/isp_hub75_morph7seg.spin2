'' =================================================================================================
''
''   File....... isp_hub75_morph7seg.spin2
''   Purpose.... One morphing 7-segment digit: its geometry, and the drawing of every segment that changed
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2021 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Jan 2021
''   Updated.... 12 Oct 2026
''   Version.... v1.0.0
''
'' =================================================================================================

{ Geometry, in digit-local pixels (u right, v down, from the digit's top-left). One coverage mask
  (isp_hub75_morphMask) of length L and thickness T serves all seven segments: a horizontal segment
  reads it as it is (rows across = v), a vertical one transposed (rows across = u). With s = ceil(T/2),
  the segments' points start s pixels past each corner's centre, so
      digit width  W = L + 2s,   digit height  H = 2W - T
  and every mask sits on whole pixels. For T = 1 that is the 2021 digit: W = L + 2, H = 2L + 3.

        u0     v0                    u0      v0
    A   s      0                 F   0       s
    G   s      W - T             B   W - T   s
    D   s      H - T             E   0       W - T + s
                                 C   W - T   W - T + s

  A column slide (E, F) travels W - T: from home to the opposite vertical.

  Drawing (spec R-4.3, R-9.3). Each frame the digit asks every segment for its state, works out the
  local rectangle each changed segment touched, and redraws only those rectangles, by screen rows.
  A pixel is the sum of every segment's mask x profile there, held to 255, then the group's intensity
  ramp (isp_hub75_morphColor): exact where anti-aliased edges meet, and full where shapes overlap.
  One copyRowRun per row; runs are clipped to the display first (the driver holds runs to the edge).
}

CON ' public control values

    DIGIT_NO_VALUE = -2   ' digit value when NOT [0-9]
    DIGIT_HIDDEN = -1     ' digit value when NOT [0-9]

    WITH_WRAP = TRUE
    WITHOUT_WRAP = FALSE
    MAX_SEGMENTS = 7
    LAST_SEGMENT = MAX_SEGMENTS - 1     ' index of the last segment slot (segments[] runs from 0)

CON ' drawing

    LEVEL_FULL = 255                    ' a fully lit pixel (mask byte, lit share and ramp index)
    LEVEL_ROUND = LEVEL_FULL / 2        ' added before dividing by LEVEL_FULL, to round to nearest
    ' a drawing context (CTX_LONGS longs, owned by the group; see setContext()): where its pixels land,
    '   screen x = CTX_XX * gx + CTX_XY * gy + CTX_X0,  screen y = CTX_YX * gx + CTX_YY * gy + CTX_Y0
    ' for (gx, gy) in group coordinates (each coefficient -1, 0 or 1: a quarter-turn rotation), and the
    ' rectangle of the display its digits may draw in (inclusive)
    #0, CTX_XX, CTX_XY, CTX_X0, CTX_YX, CTX_YY, CTX_Y0, CTX_CLIP_LEFT, CTX_CLIP_TOP, CTX_CLIP_RIGHT, CTX_CLIP_BOTTOM
    CTX_LONGS = CTX_CLIP_BOTTOM + 1
    ' the steps drawBlock() moves by, in digit coordinates, for one pixel right and one pixel down on the display
    #0, XF_U_PER_X, XF_V_PER_X, XF_U_PER_Y, XF_V_PER_Y
    XFORM_LONGS = XF_V_PER_Y + 1

    ' one slot's entry in slotTable (longs): what drawBlock() reads for it
    #0, F_MODE, F_BOX_U0, F_BOX_U1, F_BOX_V0, F_BOX_V1, F_U0, F_V0, F_VERTICAL, F_OFFSET, F_LIT
    SLOT_LONGS = F_LIT + 1
    SLOT_TABLE_LONGS = SLOT_LONGS * MAX_SEGMENTS
    MAX_SEGMENT_LENGTH = 128            ' the longest segment (mask columns) a digit can draw
    SUBPIXEL_SHIFT = 8                  ' positions are in 1/256 pixel (morphSegment.SUBPIXELS)
    SUBPIXEL_MASK = segments.SUBPIXELS - 1
    SUBPIXEL_HALF = segments.SUBPIXELS / 2
    SHARE_SHIFT = 12                    ' lit-share arithmetic is Q12
    SHARE_ONE = 1 << SHARE_SHIFT
    SHARE_HALF = SHARE_ONE / 2
    SQUARE_HALF_SHIFT = SHARE_SHIFT + 1 ' u^2 / 2 in Q12: (u * u) >> 13
    NEXT_ONE = 1                        ' one pixel, column or row further on
    CENTER_DIVISOR = 2                  ' half of a thickness (rounded up with + NEXT_ONE)
    BYTES_PER_LONG = 4
    LONG_SHIFT = 2                      ' a long index times BYTES_PER_LONG
    BYTE_BITS = 8                       ' the next byte of a packed color
    MAX_DIGIT_VALUE = 9

OBJ

    segments[MAX_SEGMENTS]     : "isp_hub75_morphSegment"
    hub75Bffrs                 : "isp_hub75_hwBufferAccess"    ' the address rule (mountedBlockRun) and the window watch

DAT ' shared drawing tables: one cog draws, one digit at a time, so one copy serves every digit

    slotTable       long    0[SLOT_TABLE_LONGS]                 ' this frame's state of every slot, for drawBlock() (F_ fields) ...
    xformTable      long    0[XFORM_LONGS]                      ' ... then the digit's steps (XF_ fields): read with it in one block
    litTable        byte    0[MAX_SEGMENTS * MAX_SEGMENT_LENGTH]    ' this frame's snake lit shares, per slot and mask column

VAR ' per digit
    long    chainIndex
    long    currValue
    long    digitGY             ' the digit's top-left in its group's coordinates (the display's, with no group)
    long    digitGX
    long    digitWidth
    long    digitHeight
    long    segCols             ' the mask's columns: segment length L
    long    segRows             ' the mask's rows: thickness T
    long    pMask               ' the group's coverage mask: segRows x segCols bytes
    long    pRamp               ' the group's intensity ramp: 256 packed colors
    long    bNeedsRender        ' TRUE from a command until the moves it started have been drawn to their end
    long    cellRows            ' one cell's (panel's) size as mounted: blocks never cross a cell
    long    cellColumns

    ' geometry per segment slot (G=0 .. A=6)
    long    segU0[MAX_SEGMENTS]
    long    segV0[MAX_SEGMENTS]
    long    segVertical[MAX_SEGMENTS]
    ' the state drawn last, per slot (renderState() values)
    long    drawnMode[MAX_SEGMENTS]
    long    drawnHead[MAX_SEGMENTS]
    long    drawnTail[MAX_SEGMENTS]
    long    drawnFromEnd[MAX_SEGMENTS]
    long    drawnOn[MAX_SEGMENTS]
    long    drawnOffset[MAX_SEGMENTS]
    long    pCtx                ' the drawing context in use: the group's (setContext()), or ownCtx
    long    screenOriginX       ' where digit pixel (0, 0) lands on the display, and the context's coefficients
    long    screenOriginY       '   and clip rectangle, copied at placement (placeDigit()) so drawing reads none
    long    coefXX              '   of them through pCtx
    long    coefXY
    long    coefYX
    long    coefYY
    long    clipLeft
    long    clipTop
    long    clipRight
    long    clipBottom
    long    ownCtx[CTX_LONGS]   ' a digit with no group draws unrotated, clipped to the display

PUB null()
'' This is NOT a top level object
''

PUB initialize(nChainIndex, nPhysicalRows, nPhysicalColumns) | segmentIndex
'' Set the display this digit draws on, and turn every segment off.
''
'' @param nChainIndex - the index of the adapter (chain of panels) this digit draws on
'' @param nPhysicalRows - the display's rows, as mounted
'' @param nPhysicalColumns - the display's columns, as mounted

    chainIndex := nChainIndex
    cellRows, cellColumns := hub75Bffrs.cellSizeInPixels(nChainIndex)
    longfill(@ownCtx, 0, CTX_LONGS)                             ' screen = group coordinates:
    ownCtx[CTX_XX] := ownCtx[CTX_YY] := NEXT_ONE                '   x = gx, y = gy
    ownCtx[CTX_CLIP_RIGHT] := nPhysicalColumns - NEXT_ONE
    ownCtx[CTX_CLIP_BOTTOM] := nPhysicalRows - NEXT_ONE
    pCtx := @ownCtx
    currValue := DIGIT_NO_VALUE
    repeat segmentIndex from 0 to LAST_SEGMENT
        segments[segmentIndex].initialize()
        drawnMode[segmentIndex] := segments.MODE_NONE

PUB digitSize(segLength, thickness) : width, height | inset
'' The pixel size of a digit with this segment length and thickness (see the geometry above).
''
'' @param segLength - the segments' length L, in pixels
'' @param thickness - the segments' thickness T, in pixels
'' @returns width - W = L + 2 x ceil(T/2)
'' @returns height - H = 2W - T

' Local Variables:
' @local inset - ceil(T/2): how far each segment's end sits past its corner's edge

    inset := (thickness + NEXT_ONE) / CENTER_DIVISOR
    width := segLength + CENTER_DIVISOR * inset
    height := CENTER_DIVISOR * width - thickness

PUB placeDigit(row, column, segLength, thickness, digitValue, pSegMask, pColorRamp, tailX256) : width, height | segmentIndex, inset, crossBar
'' Place this digit with its top-left at (row, column) and show digitValue (DIGIT_HIDDEN shows nothing).
'' The group has built the mask (thickness rows of segLength columns) and the ramp; the digit is drawn by
'' the next animate().
''
'' @param row - the digit's top row on the display
'' @param column - the digit's left column on the display
'' @param segLength - the segments' length L, in pixels
'' @param thickness - the segments' thickness T, in pixels
'' @param digitValue - 0-9, or DIGIT_HIDDEN
'' @param pSegMask - the group's coverage mask
'' @param pColorRamp - the group's intensity ramp
'' @param tailX256 - the snake tail, in 1/256 pixel
'' @returns width - the digit's width in pixels
'' @returns height - the digit's height in pixels

' Local Variables:
' @local segmentIndex - the slot being placed
' @local inset - ceil(T/2)
' @local crossBar - W - T: the middle segment's top row, the right verticals' column, and the slide distance

    digitGX := column
    digitGY := row
    coefXX := LONG[pCtx][CTX_XX]                                ' the group's transform, copied once
    coefXY := LONG[pCtx][CTX_XY]
    coefYX := LONG[pCtx][CTX_YX]
    coefYY := LONG[pCtx][CTX_YY]
    screenOriginX := coefXX * digitGX + coefXY * digitGY + LONG[pCtx][CTX_X0]
    screenOriginY := coefYX * digitGX + coefYY * digitGY + LONG[pCtx][CTX_Y0]
    clipLeft := LONG[pCtx][CTX_CLIP_LEFT]
    clipTop := LONG[pCtx][CTX_CLIP_TOP]
    clipRight := LONG[pCtx][CTX_CLIP_RIGHT]
    clipBottom := LONG[pCtx][CTX_CLIP_BOTTOM]
    segCols := segLength
    segRows := thickness
    pMask := pSegMask
    pRamp := pColorRamp
    width, height := digitSize(segLength, thickness)
    digitWidth := width
    digitHeight := height
    inset := (thickness + NEXT_ONE) / CENTER_DIVISOR
    crossBar := width - thickness
    setSlot(segments.SOR_TOP_A, inset, 0, FALSE)
    setSlot(segments.SOR_MIDDLE_G, inset, crossBar, FALSE)
    setSlot(segments.SOR_BOTTOM_D, inset, height - thickness, FALSE)
    setSlot(segments.SOR_LEFT_F, 0, inset, TRUE)
    setSlot(segments.SOR_RIGHT_B, crossBar, inset, TRUE)
    setSlot(segments.SOR_LEFT_E, 0, crossBar + inset, TRUE)
    setSlot(segments.SOR_RIGHT_C, crossBar, crossBar + inset, TRUE)
    repeat segmentIndex from 0 to LAST_SEGMENT
        segments[segmentIndex].placeSegment(NEXT_ONE << segmentIndex, segLength << SUBPIXEL_SHIFT, crossBar << SUBPIXEL_SHIFT, tailX256)
        drawnMode[segmentIndex] := segments.MODE_NONE
    currValue := DIGIT_NO_VALUE
    bNeedsRender := FALSE
    if digitValue <> DIGIT_HIDDEN
        reconfigureForDigit(digitValue)

PUB setValue(digitValue)
'' Show digitValue: 0-9 morphs from the value shown, DIGIT_HIDDEN shows nothing.
''
'' @param digitValue - 0-9, or DIGIT_HIDDEN

    if currValue <> digitValue
        reconfigureForDigit(digitValue)

PUB incrementValue(shouldWrap) | nextValue
'' Show the next digit (0 -> 9); after 9, wrap to 0 when shouldWrap is WITH_WRAP, else stay at 9.
''
'' @param shouldWrap - WITH_WRAP or WITHOUT_WRAP

    nextValue := currValue + NEXT_ONE
    if nextValue > MAX_DIGIT_VALUE
        if shouldWrap <> WITH_WRAP
            nextValue := MAX_DIGIT_VALUE
        else
            nextValue := 0
    setValue(nextValue)

PUB isAnimationComplete() : bComplete | segmentIndex
'' Return TRUE when no segment of this digit is moving.
''
'' @returns bComplete - TRUE when every segment is at rest

    bComplete := TRUE
    repeat segmentIndex from 0 to LAST_SEGMENT
        if not segments[segmentIndex].isMovementComplete()
            bComplete := FALSE
            quit

PUB animate(nowMs) : movingCount | segmentIndex
'' Move every segment to its position for time nowMs, then redraw what changed (a digit at rest draws nothing).
''
'' @param nowMs - The frame's time in ms, from isp_hub75_morphTime.update(): the same value for every group, digit and segment of a frame
'' @returns movingCount - Number of this digit's segments still moving after this call; 0 when the digit is at rest

' Local Variables:
' @local segmentIndex - Index of the segment being moved

    movingCount := 0
    if bNeedsRender                                     ' early-out: an idle digit costs one test (R-9.3)
        repeat segmentIndex from 0 to LAST_SEGMENT
            movingCount += segments[segmentIndex].animate(nowMs)
        drawChanges()
        bNeedsRender := movingCount > 0                 ' stays TRUE while a move is in flight

PUB setMotion(durationMs, easeStyle) | segmentIndex
'' Set how every segment of this digit moves: the duration of each move and its easing.
''
'' @param durationMs - Duration of each move in ms; morphCounters.setMoveDuration() checks the range
'' @param easeStyle - Easing style, timeBase.EASE_LINEAR or timeBase.EASE_SMOOTH; morphCounters.setEasing() checks it

' Local Variables:
' @local segmentIndex - Index of the segment being set

    repeat segmentIndex from 0 to LAST_SEGMENT
        segments[segmentIndex].setMotion(durationMs, easeStyle)

PUB setTail(tailX256) | segmentIndex
'' Set every segment's snake tail.
''
'' @param tailX256 - the snake tail, in 1/256 pixel

' Local Variables:
' @local segmentIndex - Index of the segment being set

    repeat segmentIndex from 0 to LAST_SEGMENT
        segments[segmentIndex].setTail(tailX256)

PUB commandSegment(segmentIndex, commandBits) : status
'' Send one command byte to one segment (for tests; the digit's own transitions come from the table).
''
'' @param segmentIndex - the slot, 0 (G) to LAST_SEGMENT (A)
'' @param commandBits - Command byte %GGG_AAAT
'' @returns status - the segment's status: morphStatus SUCCESS or E_BAD_COMMAND

    status := segments[segmentIndex].commandSegment(commandBits)
    bNeedsRender := TRUE

PUB morphOut() | segmentIndex
'' Turn every lit segment off with a snake (horizontals left to right, verticals top down): the digit morphs out
'' and ends hidden.
''

    repeat segmentIndex from 0 to LAST_SEGMENT
        if segVertical[segmentIndex]
            segments[segmentIndex].commandSegment(segments.CMD_TURN_OFF + segments.CMD_TOP_DOWN)
        else
            segments[segmentIndex].commandSegment(segments.CMD_TURN_OFF + segments.CMD_LT_TO_RT)
    currValue := DIGIT_HIDDEN
    bNeedsRender := TRUE

PUB setContext(pGroupContext)
'' Draw through a group's context: its transform and its clip rectangle (CTX_ fields), taken at the next
'' placeDigit(). The group owns the block and fills it before placing its digits.
''
'' @param pGroupContext - hub address of the group's CTX_LONGS longs

    pCtx := pGroupContext

PRI setSlot(orientation, leftU, topV, bVertical) | slot
' Record one segment's mask position and direction; its slot is its orientation's bit position.

    slot := encod orientation
    segU0[slot] := leftU
    segV0[slot] := topV
    segVertical[slot] := bVertical

PRI drawChanges() | slot, mode, head, tail, bFromEnd, bOn, offset, colLo, colHi, posLo, posHi
' Read every segment's state, then redraw the local rectangle each changed segment touched (old and new).

' Local Variables:
' @local slot - the segment slot
' @local mode, head, tail, bFromEnd, bOn, offset - the slot's renderState() this frame
' @local colLo, colHi - a snake's changed columns, from its start end
' @local posLo, posHi - the lower and higher of two positions, in 1/256 pixel

    ' first every slot's new state and box, so each redraw composites the frame's state of every segment,
    ' and this digit's steps for drawBlock(): the inverse of a rotation is its transpose
    repeat slot from 0 to LAST_SEGMENT
        segStateLoad(slot)
    xformTable[XF_U_PER_X] := coefXX
    xformTable[XF_V_PER_X] := coefXY
    xformTable[XF_U_PER_Y] := coefYX
    xformTable[XF_V_PER_Y] := coefYY
    repeat slot from 0 to LAST_SEGMENT
        mode, head, tail, bFromEnd, bOn, offset := frameMode[slot], frameHead[slot], frameTail[slot], frameFromEnd[slot], frameOn[slot], frameOffset[slot]
        if mode <> drawnMode[slot] or tail <> drawnTail[slot] or bFromEnd <> drawnFromEnd[slot] or bOn <> drawnOn[slot]
            drawStateRect(slot, drawnMode[slot], drawnOffset[slot])         ' where it was ...
            drawStateRect(slot, mode, offset)                               ' ... and where it is
        elseif mode == segments.MODE_SNAKE and head <> drawnHead[slot]
            posLo := (head <# drawnHead[slot]) - tail - segments.SUBPIXELS
            posHi := (head #> drawnHead[slot]) + segments.SUBPIXELS
            colLo := (posLo sar SUBPIXEL_SHIFT) #> 0
            colHi := (posHi sar SUBPIXEL_SHIFT) <# (segCols - NEXT_ONE)
            if bFromEnd                                                     ' columns counted from the far end: mirror the range
                posLo := segCols - NEXT_ONE - colHi
                colHi := segCols - NEXT_ONE - colLo
                colLo := posLo
            if colLo <= colHi
                drawAlong(slot, colLo, colHi)
        elseif mode == segments.MODE_SLIDE and offset <> drawnOffset[slot]
            drawSlideRect(slot, drawnOffset[slot], offset)
        drawnMode[slot] := mode
        drawnHead[slot] := head
        drawnTail[slot] := tail
        drawnFromEnd[slot] := bFromEnd
        drawnOn[slot] := bOn
        drawnOffset[slot] := offset

DAT ' this frame's state per slot, for the pixel loop (the digits draw one at a time, so one copy serves all)

    frameMode       long    0[MAX_SEGMENTS]
    frameHead       long    0[MAX_SEGMENTS]
    frameTail       long    0[MAX_SEGMENTS]
    frameFromEnd    long    0[MAX_SEGMENTS]
    frameOn         long    0[MAX_SEGMENTS]
    frameOffset     long    0[MAX_SEGMENTS]

PRI segStateLoad(slot) | pEntry
' Load one slot's state for this frame into the frame arrays and its slotTable entry, with its bounding box
' (local, inclusive) where it is drawn now.

' Local Variables:
' @local pEntry - the slot's slotTable entry

    frameMode[slot], frameHead[slot], frameTail[slot], frameFromEnd[slot], frameOn[slot], frameOffset[slot] := segments[slot].renderState()
    if frameMode[slot] == segments.MODE_SNAKE
        fillLitShares(slot)
    pEntry := @slotTable + slot * SLOT_LONGS * BYTES_PER_LONG
    LONG[pEntry][F_BOX_U0], LONG[pEntry][F_BOX_V0], LONG[pEntry][F_BOX_U1], LONG[pEntry][F_BOX_V1] := stateBox(slot, frameMode[slot], frameOffset[slot])
    LONG[pEntry][F_MODE] := frameMode[slot]
    LONG[pEntry][F_U0] := segU0[slot]
    LONG[pEntry][F_V0] := segV0[slot]
    LONG[pEntry][F_VERTICAL] := segVertical[slot]
    LONG[pEntry][F_OFFSET] := frameOffset[slot]
    LONG[pEntry][F_LIT] := @litTable + slot * MAX_SEGMENT_LENGTH

PRI stateBox(slot, mode, offset) : leftU, topV, rightU, bottomV
' A slot's box (local, inclusive) in this mode: a slide's column moved sideways by offset (1/256 pixel), any
' other mode at home.

    if mode <> segments.MODE_SLIDE
        offset := segments.NO_OFFSET
    if segVertical[slot]
        leftU := segU0[slot] + (offset sar SUBPIXEL_SHIFT)
        rightU := segU0[slot] + segRows - NEXT_ONE + ((offset + SUBPIXEL_MASK) sar SUBPIXEL_SHIFT)
        topV := segV0[slot]
        bottomV := topV + segCols - NEXT_ONE
    else
        leftU := segU0[slot]
        rightU := leftU + segCols - NEXT_ONE
        topV := segV0[slot]
        bottomV := topV + segRows - NEXT_ONE

PRI drawStateRect(slot, mode, offset) | leftU, topV, rightU, bottomV
' Redraw the box a slot covers in this mode at this offset (nothing for MODE_NONE).

    if mode <> segments.MODE_NONE
        leftU, topV, rightU, bottomV := stateBox(slot, mode, offset)
        drawLocalRect(leftU, topV, rightU, bottomV)

PRI drawSlideRect(slot, fromOffset, toOffset) | leftU, topV, rightU, bottomV, otherLeftU, otherRightU
' Redraw where a sliding column was and where it is now, as one rectangle: the two boxes overlap.

    leftU, topV, rightU, bottomV := stateBox(slot, segments.MODE_SLIDE, fromOffset)
    otherLeftU, _, otherRightU, _ := stateBox(slot, segments.MODE_SLIDE, toOffset)
    drawLocalRect(leftU <# otherLeftU, topV, rightU #> otherRightU, bottomV)

PRI drawAlong(slot, colLo, colHi)
' Redraw columns colLo..colHi of a slot's mask (along the segment), its full thickness.

    if segVertical[slot]
        drawLocalRect(segU0[slot], segV0[slot] + colLo, segU0[slot] + segRows - NEXT_ONE, segV0[slot] + colHi)
    else
        drawLocalRect(segU0[slot] + colLo, segV0[slot], segU0[slot] + colHi, segV0[slot] + segRows - NEXT_ONE)

PRI drawLocalRect(leftU, topV, rightU, bottomV) | firstX, lastX, firstY, lastY, cornerX, cornerY, blockX0, blockX1, blockY0, blockY1, pPixel, rightStep, downStep, blockU, blockV
' Redraw a local rectangle: through the context's transform onto the display, clipped to the context's clip
' rectangle, split into blocks that each lie in one cell (one panel), each block drawn by drawBlock() at the
' address and steps the driver's address rule gives (hub75Bffrs.mountedBlockRun()); then the driver's window
' watch is told what was written.

' Local Variables:
' @local firstX, lastX, firstY, lastY - the rectangle on the display, clipped
' @local cornerX, cornerY - the rectangle's far corner on the display
' @local blockX0, blockX1, blockY0, blockY1 - the block being drawn: the rectangle's part in one cell
' @local pPixel, rightStep, downStep - the block's top-left pixel address and its steps, or NO_PIXEL
' @local blockU, blockV - the block's top-left display pixel in digit coordinates

    firstX, firstY := toScreen(leftU, topV)                     ' a quarter-turn maps a rectangle to a rectangle:
    cornerX, cornerY := toScreen(rightU, bottomV)               ' its two corners bound it
    lastX := (firstX #> cornerX) <# clipRight
    firstX := (firstX <# cornerX) #> clipLeft
    lastY := (firstY #> cornerY) <# clipBottom
    firstY := (firstY <# cornerY) #> clipTop
    if firstX <= lastX and firstY <= lastY
        blockY0 := firstY
        repeat while blockY0 <= lastY
            blockY1 := ((blockY0 / cellRows + NEXT_ONE) * cellRows - NEXT_ONE) <# lastY
            blockX0 := firstX
            repeat while blockX0 <= lastX
                blockX1 := ((blockX0 / cellColumns + NEXT_ONE) * cellColumns - NEXT_ONE) <# lastX
                pPixel, rightStep, downStep := hub75Bffrs.mountedBlockRun(chainIndex, blockY0, blockX0, blockY1 - blockY0 + NEXT_ONE, blockX1 - blockX0 + NEXT_ONE)
                if pPixel <> hub75Bffrs.NO_PIXEL                     ' a cell that holds no panel draws nothing
                    blockU, blockV := toLocal(blockX0, blockY0)
                    drawBlock(pPixel, rightStep, downStep, blockU, blockV, blockX1 - blockX0 + NEXT_ONE, blockY1 - blockY0 + NEXT_ONE)
                blockX0 := blockX1 + NEXT_ONE
            blockY0 := blockY1 + NEXT_ONE
        hub75Bffrs.noteDrawn(chainIndex, firstY, firstX, lastY, lastX)

PRI toScreen(localU, localV) : screenX, screenY
' A digit pixel's place on the display, through the group's transform.

    screenX := screenOriginX + coefXX * localU + coefXY * localV
    screenY := screenOriginY + coefYX * localU + coefYY * localV

PRI toLocal(screenX, screenY) : localU, localV
' A display pixel in digit coordinates: the transform's inverse (a rotation's inverse is its transpose).

    screenX -= screenOriginX
    screenY -= screenOriginY
    localU := coefXX * screenX + coefYX * screenY
    localV := coefXY * screenX + coefYY * screenY

PRI drawBlock(pPixel, rightStep, downStep, firstU, firstV, nColumns, nRows) | pSlots, pMaskB, maskCols, maskRows, pRampB, rowPixel, localU, localV, colsLeft
' Draw one block in one cell, inline PASM (cog-exec), walking digit coordinates by xformTable's steps: for every pixel, the sum of every segment's level there
' (its mask; times its snake's lit share; or its mask slid sideways), held to LEVEL_FULL, through the ramp,
' written as the pixel's three bytes (red, green, blue: the driver's writePacked() order).
'
' @param pPixel - hub address of the block's top-left pixel
' @param rightStep - signed bytes to the next pixel right, in this cell
' @param downStep - signed bytes to the next pixel down, in this cell
' @param firstU - the block's top-left display pixel, in digit coordinates (u)
' @param firstV - the block's top-left display pixel, in digit coordinates (v)
' @param nColumns - the block's width
' @param nRows - the block's height

' Local Variables (the first 16 longs, mapped to cog registers by name):
' @local pSlots - this frame's slot table (SLOT_LONGS per slot)
' @local pMaskB - the group's coverage mask
' @local maskCols, maskRows - the mask's columns (segment length) and rows (thickness)
' @local pRampB - the group's intensity ramp
' @local rowPixel - the current row's first pixel
' @local localU, localV - the current pixel, digit-local
' @local colsLeft - pixels left in the current row

    pSlots := @slotTable
    pMaskB := pMask
    maskCols := segCols
    maskRows := segRows
    pRampB := pRamp
    rowPixel := pPixel
    org
                setq    #SLOT_TABLE_LONGS + XFORM_LONGS - NEXT_ONE  ' the slot table and the steps, into cog registers
                rdlong  slots, pSlots
.row
                mov     localU, firstU                          ' the row's first pixel, digit-local
                mov     localV, firstV
                mov     nActive, #0                             ' the slots that can cover this row
                mov     slotBase, #0
                mov     slotsLeft, #MAX_SEGMENTS
.scan
                alts    slotBase, #slots + F_MODE
                mov     t1, 0-0                 wz
    if_z        jmp     #.scanNext                              ' MODE_NONE
                tjz     stepVx, #.scanV                         ' v is the same along the row: test v ...
                alts    slotBase, #slots + F_BOX_U0             ' ... else u is: test u
                cmps    localU, 0-0             wc
    if_c        jmp     #.scanNext
                alts    slotBase, #slots + F_BOX_U1
                mov     t1, 0-0
                cmps    t1, localU              wc
    if_c        jmp     #.scanNext
                jmp     #.scanKeep
.scanV
                alts    slotBase, #slots + F_BOX_V0
                cmps    localV, 0-0             wc
    if_c        jmp     #.scanNext
                alts    slotBase, #slots + F_BOX_V1
                mov     t1, 0-0
                cmps    t1, localV              wc
    if_c        jmp     #.scanNext
.scanKeep
                altd    nActive, #active
                mov     0-0, slotBase
                add     nActive, #NEXT_ONE
.scanNext
                add     slotBase, #SLOT_LONGS
                djnz    slotsLeft, #.scan

                mov     pix, rowPixel
                mov     colsLeft, nColumns
.pixel
                mov     sum, #0
                mov     activeIdx, #0
                mov     activeLeft, nActive     wz
    if_z        jmp     #.store
.slot
                alts    activeIdx, #active
                mov     slotBase, 0-0
                add     activeIdx, #NEXT_ONE
                alts    slotBase, #slots + F_BOX_U0
                cmps    localU, 0-0                  wc
    if_c        jmp     #.slotNext
                alts    slotBase, #slots + F_BOX_U1
                mov     t1, 0-0
                cmps    t1, localU                   wc
    if_c        jmp     #.slotNext
                alts    slotBase, #slots + F_BOX_V0
                cmps    localV, 0-0             wc
    if_c        jmp     #.slotNext
                alts    slotBase, #slots + F_BOX_V1
                mov     t1, 0-0
                cmps    t1, localV              wc
    if_c        jmp     #.slotNext
                alts    slotBase, #slots + F_U0                 ' across and along the segment's mask
                mov     t1, 0-0
                mov     du, localU
                sub     du, t1
                alts    slotBase, #slots + F_V0
                mov     t1, 0-0
                mov     dv, localV
                sub     dv, t1
                alts    slotBase, #slots + F_VERTICAL
                mov     t1, 0-0                 wz
    if_z        mov     across, dv
    if_z        mov     along, du
    if_nz       mov     across, du
    if_nz       mov     along, dv
                alts    slotBase, #slots + F_MODE
                mov     mode, 0-0
                cmp     mode, #segments.MODE_SLIDE  wz
    if_z        jmp     #.slide
                mov     t1, across                              ' full or snake: the mask byte
                mul     t1, maskCols
                add     t1, along
                add     t1, pMaskB
                rdbyte  level, t1
                cmp     mode, #segments.MODE_SNAKE  wz
    if_nz       jmp     #.add
                alts    slotBase, #slots + F_LIT                ' snake: times the column's lit share, / 255 rounded
                mov     t1, 0-0
                add     t1, along
                rdbyte  t2, t1
                mul     level, t2
                add     level, #LEVEL_ROUND + NEXT_ONE
                mov     t2, level
                shr     t2, #SUBPIXEL_SHIFT
                add     level, t2
                shr     level, #SUBPIXEL_SHIFT
                jmp     #.add
.slide
                alts    slotBase, #slots + F_OFFSET             ' slide: the mask moved sideways, two rows blended
                mov     t1, 0-0
                mov     t2, across
                shl     t2, #SUBPIXEL_SHIFT
                sub     t2, t1
                mov     coverNext, t2
                and     coverNext, #SUBPIXEL_MASK
                sar     t2, #SUBPIXEL_SHIFT
                mov     m0, #0
                cmp     t2, maskRows            wc              ' unsigned: a row above the mask reads as huge
    if_c        mov     t1, t2
    if_c        mul     t1, maskCols
    if_c        add     t1, along
    if_c        add     t1, pMaskB
    if_c        rdbyte  m0, t1
                add     t2, #NEXT_ONE
                mov     m1, #0
                cmp     t2, maskRows            wc
    if_c        mov     t1, t2
    if_c        mul     t1, maskCols
    if_c        add     t1, along
    if_c        add     t1, pMaskB
    if_c        rdbyte  m1, t1
                mov     t1, ##segments.SUBPIXELS
                sub     t1, coverNext
                mul     m0, t1
                mul     m1, coverNext
                add     m0, m1
                add     m0, #SUBPIXEL_HALF
                shr     m0, #SUBPIXEL_SHIFT
                mov     level, m0
.add
                add     sum, level
.slotNext
                djnz    activeLeft, #.slot
.store
                fle     sum, #LEVEL_FULL                        ' through the ramp, then red, green, blue bytes
                shl     sum, #LONG_SHIFT
                add     sum, pRampB
                rdlong  t1, sum
                wrbyte  t1, pix
                shr     t1, #BYTE_BITS
                mov     t2, pix
                add     t2, #NEXT_ONE
                wrbyte  t1, t2
                shr     t1, #BYTE_BITS
                add     t2, #NEXT_ONE
                wrbyte  t1, t2
                add     pix, rightStep
                add     localU, stepUx                          ' one pixel right on the display, in digit coordinates
                add     localV, stepVx
                djnz    colsLeft, #.pixel
                add     rowPixel, downStep
                add     firstU, stepUy                          ' one pixel down
                add     firstV, stepVy
                djnz    nRows, #.row
                ret

slots           long    0[SLOT_TABLE_LONGS]
stepUx          long    0                                       ' xformTable, loaded with the slots (XF_ order)
stepVx          long    0
stepUy          long    0
stepVy          long    0
active          long    0[MAX_SEGMENTS]
nActive         long    0
slotBase        long    0
slotsLeft       long    0
activeIdx       long    0
activeLeft      long    0
pix             long    0
sum             long    0
t1              long    0
t2              long    0
du              long    0
dv              long    0
across          long    0
along           long    0
mode            long    0
level           long    0
coverNext       long    0
m0              long    0
m1              long    0
    end

PRI fillLitShares(slot) | fromStart, distance, tail, head, share, pLit, fullBelow, darkFrom, bOn, bFromEnd, behindLevel, aheadLevel
' A snake's lit share (0-255) of every mask column, into litTable: the average over the column of
' clamp((head - x) / tail, 0, 1), x measured from the snake's start end; turning off lights the rest.
' Columns wholly behind the moving edge and columns past the head take one level each (bytefill); only the
' columns of the edge itself (about tail + 2) are worked out.

' Local Variables:
' @local fromStart - a column's index counted from the snake's start end
' @local distance - head minus the column's near edge, in 1/256 pixel
' @local tail, head - the snake's tail and head, in 1/256 pixel
' @local share - the column's lit share
' @local pLit - this slot's lit shares
' @local fullBelow - columns (from the start end) below this lie wholly behind head - tail
' @local darkFrom - columns (from the start end) from this one on lie at or past the head
' @local bOn, bFromEnd - turning on; counted from the far end
' @local behindLevel, aheadLevel - the share behind the edge and past the head

    tail := frameTail[slot]
    head := frameHead[slot]
    bOn := frameOn[slot]
    bFromEnd := frameFromEnd[slot]
    pLit := @litTable + slot * MAX_SEGMENT_LENGTH
    fullBelow := (((head - tail) sar SUBPIXEL_SHIFT) - NEXT_ONE) #> 0 <# segCols
    darkFrom := ((head + SUBPIXEL_MASK) sar SUBPIXEL_SHIFT) #> fullBelow <# segCols
    behindLevel := bOn ? LEVEL_FULL : 0
    aheadLevel := LEVEL_FULL - behindLevel
    if bFromEnd
        bytefill(pLit + segCols - fullBelow, behindLevel, fullBelow)
        bytefill(pLit, aheadLevel, segCols - darkFrom)
    else
        bytefill(pLit, behindLevel, fullBelow)
        bytefill(pLit + darkFrom, aheadLevel, segCols - darkFrom)
    fromStart := fullBelow
    repeat darkFrom - fullBelow                                         ' the edge's columns (none when it has no width)
        distance := head - (fromStart << SUBPIXEL_SHIFT)
        ' average of clamp(t) over the column = tail x (G(distance / tail) - G((distance - 1 px) / tail)), G the integral of clamp
        share := ((rampIntegral((distance << SHARE_SHIFT) / tail) - rampIntegral(((distance - segments.SUBPIXELS) << SHARE_SHIFT) / tail)) * tail) sar SUBPIXEL_SHIFT
        share := ((share * LEVEL_FULL + SHARE_HALF) sar SHARE_SHIFT) #> 0 <# LEVEL_FULL
        if not bOn
            share := LEVEL_FULL - share
        BYTE[pLit][bFromEnd ? segCols - NEXT_ONE - fromStart : fromStart] := share
        fromStart++

PRI rampIntegral(position) : area
' The integral from 0 of clamp(x, 0, 1) up to position, all in Q12: 0 below 0, x^2 / 2 to 1, then x - 1/2.

    if position <= 0
        area := 0
    elseif position < SHARE_ONE
        area := (position * position) >> SQUARE_HALF_SHIFT
    else
        area := position - SHARE_HALF

PRI turnOnDigit(digit) | toSegments, bitIndex
' Show a digit from blank: each of its segments turns on at once (the first value a digit shows).

    toSegments := byte[@segmentsByDigit][digit]
    repeat bitIndex from LAST_SEGMENT to 0
        if toSegments & (NEXT_ONE << bitIndex)
            segments[bitIndex].commandSegment(segments.CMD_TURN_ON + segments.CMD_IMMEDIATE)
    bNeedsRender := TRUE

PRI reconfigureForDigit(digitValue) | pLtTable, pRtTable, actionIndex, segmentIndex, nextAction
' Start the transition from the value shown to digitValue: the generated table's commands, or a first showing.

    if currValue <> digitValue
        if digitValue == DIGIT_HIDDEN
            repeat segmentIndex from 0 to LAST_SEGMENT
                segments[segmentIndex].commandSegment(segments.CMD_TURN_OFF + segments.CMD_IMMEDIATE)
            bNeedsRender := TRUE
        elseif currValue < 0
            turnOnDigit(digitValue)
        else
            pLtTable := @@leftPtrs[currValue]
            pRtTable := @@LONG[pLtTable][digitValue]
            if pRtTable <> NO_ACTIONS
                actionIndex := 0
                repeat
                    nextAction := BYTE[pRtTable][actionIndex++]
                    if nextAction <> 0
                        segmentIndex := (nextAction & segments.MASK_SEGMENT) >> segments.SEGMENT_ID_SHIFT - NEXT_ONE
                        segments[segmentIndex].commandSegment(nextAction)
                    else
                        quit
            bNeedsRender := TRUE
    currValue := digitValue

CON ' table markers

  NO_ACTIONS = 0

DAT ' digit shapes and the generated transition table

segmentsByDigit
    byte    %0111_1110   ' 0 abcdef-
    byte    %0011_0000   ' 1 -bc----
    byte    %0110_1101   ' 2 ab-de-g
    byte    %0111_1001   ' 3 abcd--g
    byte    %0011_0011   ' 4 -bc--fg
    byte    %0101_1011   ' 5 a-cd-fg
    byte    %0101_1111   ' 6 a-cdefg
    byte    %0111_0000   ' 7 abc----
    byte    %0111_1111   ' 8 abcdefg
    byte    %0111_1011   ' 9 abcd-fg

' NEW TABLE of Actions:
'leftPtrsActual  long    0
'leftPtrsAddr    long    @leftPtrs
'objectOffset    long    0

' NOTE from spin2 doc pg4 symbol standing alone inherits last declared type!!
' =======================================================================================================================
leftPtrs LONG @tableLt0, @tableLt1, @tableLt2, @tableLt3, @tableLt4, @tableLt5, @tableLt6, @tableLt7, @tableLt8, @tableLt9
' -----------------------------------------------------------------------------------------------------------------------
tableLt0
    LONG NO_ACTIONS, @fm0_1, @fm0_2, @fm0_3, @fm0_4, @fm0_5, @fm0_6, @fm0_7, @fm0_8, @fm0_9
tableLt1
    LONG @fm1_0, NO_ACTIONS, @fm1_2, @fm1_3, @fm1_4, @fm1_5, @fm1_6, @fm1_7, @fm1_8, @fm1_9
tableLt2
    LONG @fm2_0, @fm2_1, NO_ACTIONS, @fm2_3, @fm2_4, @fm2_5, @fm2_6, @fm2_7, @fm2_8, @fm2_9
tableLt3
    LONG @fm3_0, @fm3_1, @fm3_2, NO_ACTIONS, @fm3_4, @fm3_5, @fm3_6, @fm3_7, @fm3_8, @fm3_9
tableLt4
    LONG @fm4_0, @fm4_1, @fm4_2, @fm4_3, NO_ACTIONS, @fm4_5, @fm4_6, @fm4_7, @fm4_8, @fm4_9
tableLt5
    LONG @fm5_0, @fm5_1, @fm5_2, @fm5_3, @fm5_4, NO_ACTIONS, @fm5_6, @fm5_7, @fm5_8, @fm5_9
tableLt6
    LONG @fm6_0, @fm6_1, @fm6_2, @fm6_3, @fm6_4, @fm6_5, NO_ACTIONS, @fm6_7, @fm6_8, @fm6_9
tableLt7
    LONG @fm7_0, @fm7_1, @fm7_2, @fm7_3, @fm7_4, @fm7_5, @fm7_6, NO_ACTIONS, @fm7_8, @fm7_9
tableLt8
    LONG @fm8_0, @fm8_1, @fm8_2, @fm8_3, @fm8_4, @fm8_5, @fm8_6, @fm8_7, NO_ACTIONS, @fm8_9
tableLt9
    LONG @fm9_0, @fm9_1, @fm9_2, @fm9_3, @fm9_4, @fm9_5, @fm9_6, @fm9_7, @fm9_8, NO_ACTIONS
' =======================================================================================================================


fm0_1
	' transition #1: digit 0 -> 1
	' 4 segments changing, #ON=0, #OFF=4
	' seg[a] turning OFF while [b] is staying ON.
	' Segment [a] snakes OFF towards [b]
	byte	segments.SEG_TOP_A + segments.CMD_TURN_OFF + segments.CMD_LT_TO_RT
	' seg[d] turning OFF while [c] is staying ON.
	' Segment [d] snakes OFF towards [c]
	byte	segments.SEG_BOTTOM_D + segments.CMD_TURN_OFF + segments.CMD_LT_TO_RT
	' seg[e] turning OFF while [c] is staying ON.
	' VERT Segment [e] slides RIGHT to [c]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_OFF + segments.CMD_COL_TO_RT
	' seg[f] turning OFF while [b] is staying ON.
	' VERT Segment [f] slides RIGHT to [b]
	byte	segments.SEG_LEFT_F + segments.CMD_TURN_OFF + segments.CMD_COL_TO_RT
	byte	0	' terminate entry

fm0_2
	' transition #2: digit 0 -> 2
	' 3 segments changing, #ON=1, #OFF=2
	' seg[c] turning OFF while [b] is staying ON.
	' Segment [c] snakes OFF towards [b]
	byte	segments.SEG_RIGHT_C + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[f] turning OFF while [a] is staying ON.
	' Segment [f] snakes OFF towards [a]
	byte	segments.SEG_LEFT_F + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm0_3
	' transition #3: digit 0 -> 3
	' 3 segments changing, #ON=1, #OFF=2
	' seg[e] turning OFF while [d] is staying ON.
	' Segment [e] snakes OFF towards [d]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_OFF + segments.CMD_TOP_DOWN
	' seg[f] turning OFF while [a] is staying ON.
	' Segment [f] snakes OFF towards [a]
	byte	segments.SEG_LEFT_F + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm0_4
	' transition #4: digit 0 -> 4
	' 4 segments changing, #ON=1, #OFF=3
	' seg[a] turning OFF while [b] is staying ON.
	' Segment [a] snakes OFF towards [b]
	byte	segments.SEG_TOP_A + segments.CMD_TURN_OFF + segments.CMD_LT_TO_RT
	' seg[d] turning OFF while [c] is staying ON.
	' Segment [d] snakes OFF towards [c]
	byte	segments.SEG_BOTTOM_D + segments.CMD_TURN_OFF + segments.CMD_LT_TO_RT
	' seg[e] turning OFF while [g] is turning ON.
	' Segment [e] snakes OFF towards [g]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm0_5
	' transition #5: digit 0 -> 5
	' 3 segments changing, #ON=1, #OFF=2
	' seg[b] turning OFF while [a] is staying ON.
	' Segment [b] snakes OFF towards [a]
	byte	segments.SEG_RIGHT_B + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[e] turning OFF while [d] is staying ON.
	' Segment [e] snakes OFF towards [d]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_OFF + segments.CMD_TOP_DOWN
	' seg[g] turning ON while [b] is turning OFF.
	' Segment [g] snakes ON towards [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_LT_TO_RT
	byte	0	' terminate entry

fm0_6
	' transition #6: digit 0 -> 6
	' 2 segments changing, #ON=1, #OFF=1
	' seg[b] turning OFF while [a] is staying ON.
	' Segment [b] snakes OFF towards [a]
	byte	segments.SEG_RIGHT_B + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[g] turning ON while [b] is turning OFF.
	' Segment [g] snakes ON towards [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_LT_TO_RT
	byte	0	' terminate entry

fm0_7
	' transition #7: digit 0 -> 7
	' 3 segments changing, #ON=0, #OFF=3
	' seg[d] turning OFF while [c] is staying ON.
	' Segment [d] snakes OFF towards [c]
	byte	segments.SEG_BOTTOM_D + segments.CMD_TURN_OFF + segments.CMD_LT_TO_RT
	' seg[e] turning OFF while [c] is staying ON.
	' VERT Segment [e] slides RIGHT to [c]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_OFF + segments.CMD_COL_TO_RT
	' seg[f] turning OFF while [a] is staying ON.
	' Segment [f] snakes OFF towards [a]
	byte	segments.SEG_LEFT_F + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	byte	0	' terminate entry

fm0_8
	' transition #8: digit 0 -> 8
	' 1 segment changing, #ON=1, #OFF=0
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm0_9
	' transition #9: digit 0 -> 9
	' 2 segments changing, #ON=1, #OFF=1
	' seg[e] turning OFF while [d] is staying ON.
	' Segment [e] snakes OFF towards [d]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_OFF + segments.CMD_TOP_DOWN
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm1_0
	' transition #10: digit 1 -> 0
	' 4 segments changing, #ON=4, #OFF=0
	' seg[a] turning ON while [b] is staying ON.
	' Segment [a] snakes ON away from [b]
	byte	segments.SEG_TOP_A + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	' seg[d] turning ON while [c] is staying ON.
	' Segment [d] snakes ON away from [c]
	byte	segments.SEG_BOTTOM_D + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	' seg[e] turning ON while [g] is staying OFF.
	' Segment [e] snakes ON towards [g]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_ON + segments.CMD_BOTTOM_UP
	' seg[f] turning ON while [g] is staying OFF.
	' Segment [f] snakes ON towards [g]
	byte	segments.SEG_LEFT_F + segments.CMD_TURN_ON + segments.CMD_TOP_DOWN
	byte	0	' terminate entry

fm1_2
	' transition #11: digit 1 -> 2
	' 5 segments changing, #ON=4, #OFF=1
	' seg[c] turning OFF while [b] is staying ON.
	' Segment [c] snakes OFF towards [b]
	byte	segments.SEG_RIGHT_C + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[a] turning ON while [b] is staying ON.
	' Segment [a] snakes ON away from [b]
	byte	segments.SEG_TOP_A + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	' seg[d] turning ON while [c] is turning OFF.
	' Segment [d] snakes ON towards [c]
	byte	segments.SEG_BOTTOM_D + segments.CMD_TURN_ON + segments.CMD_LT_TO_RT
	' seg[e] turning ON while [f] is staying OFF.
	' Segment [e] snakes ON towards [f]
	byte	segments.SEG_LEFT_E + segments.CMD_TURN_ON + segments.CMD_BOTTOM_UP
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm1_3
	' transition #12: digit 1 -> 3
	' 3 segments changing, #ON=3, #OFF=0
	' seg[a] turning ON while [b] is staying ON.
	' Segment [a] snakes ON away from [b]
	byte	segments.SEG_TOP_A + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	' seg[d] turning ON while [c] is staying ON.
	' Segment [d] snakes ON away from [c]
	byte	segments.SEG_BOTTOM_D + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm1_4
	' transition #13: digit 1 -> 4
	' 2 segments changing, #ON=2, #OFF=0
	' seg[f] turning ON while [a] is staying OFF.
	' Segment [f] snakes ON towards [a]
	byte	segments.SEG_LEFT_F + segments.CMD_TURN_ON + segments.CMD_BOTTOM_UP
	' seg[g] turning ON while [b] is staying ON.
	' Segment [g] snakes ON away from [b]
	byte	segments.SEG_MIDDLE_G + segments.CMD_TURN_ON + segments.CMD_RT_TO_LT
	byte	0	' terminate entry

fm1_5
	' transition #14: digit 1 -> 5
	' 5 segments changing, #ON=4, #OFF=1
	' seg[b] turning OFF while [a] is turning ON.
	' Segment [b] snakes OFF towards [a]
	byte	segments.SEG_RIGHT_B + segments.CMD_TURN_OFF + segments.CMD_BOTTOM_UP
	' seg[a] turning ON while [b] is turning OFF.
	' Segment [a] snakes ON towards [b]
	byte	segments.SEG_TOP_A + segments.CMD_TURN_ON + segments.CMD_LT_TO_RT
