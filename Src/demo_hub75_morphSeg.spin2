'' =================================================================================================
''
''   File....... isp_hub75_demoMorphSeg.spin2
''   Purpose.... Top-level Demonstration - showing off our HUB75 matrix w/Morphing 7 segment displays
''   Authors.... Stephen M Moraco
''               -- Copyright (c) 2021 Iron Sheep Productions, LLC
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Jan 2021
''   Updated.... 12 Oct 2026
''
'' =================================================================================================


CON { timing }

  CLK_FREQ = 335_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON { DEBUG PINs }

'DEBUG_PIN = 0

CON { Display constants }

MAX_COUNTERS = 4
LAST_COUNTER = MAX_COUNTERS - 1

#0, GRP_CLOCK_LT, GRP_CLOCK_RT, GRP_DOWNCTR_2DIG, GRP_CTR_6DIG_RAND
THIN_STROKE = 1             ' the 2021 look: 1-pixel strokes

CON ' the 2021 pacing, in real time

  ' In 2021 every pixel took one loop pass (22.2 ms at 45.06 passes/s), so a transition took longer on bigger digits,
  ' and a group held each value for 8 to 10 passes. These reproduce that look (Docs/analysis/morph-time-design.md section d):
  CLOCK_MOVE_MS = 111       ' clocks, 6 px segments: 5 passes
  RANDOM_MOVE_MS = 178      ' random group, 9 px segments: 8 passes
  DOWNCTR_MOVE_MS = 311     ' down counter, 15 px segments: 14 passes
  HOLD_MS = 200             ' hold after each transition: the middle of 178 to 222 ms

VAR

    long    cog
    long    digitVal
    long    digitIndex
    long    hours
    long    hours24
    long    minutes
    long    digitHeight
    long    digitWidth
    long    segmentThickness   ' FIXME UNDONE, not plumbed thru yet
    ' 1st clock group
    long    clkLtWidth
    long    clkLtHeight
    long    clkRtWidth
    long    clkRtHeight
    long    grpDnWidth
    long    grpDnHeight
    long    grpRndWidth
    long    grpRndHeight

OBJ

    color                   : "isp_hub75_color"
    display                 : "isp_hub75_display"
    counters[MAX_COUNTERS]  : "isp_hub75_morphCounters"
    hub75Bffrs              : "isp_hub75_hwBufferAccess"
    timeBase                : "isp_hub75_morphTime"

PUB start() : ok | ctrIdx, chainIndex, maxPhysicalCols, maxPhysicalRows, nowMs
    '' Start underlying drivers and run demo

    'debug("`term temp size 82 50 textsize 10")
    chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)
    ' configures the adapter from isp_hub75_hwPanelConfig and starts the driver (aborts on failure)
    ok := cog := display.start(display.HUB75_ADAPTER_1)
    maxPhysicalCols := hub75Bffrs.maxDisplayColumns(chainIndex)
    maxPhysicalRows := hub75Bffrs.maxDisplayRows(chainIndex)

    '  multiple SEVEN SEGMENT Morphing Digits DEMO: the 2021 thin strokes
    repeat ctrIdx from 0 to MAX_COUNTERS -1
        counters[ctrIdx].setThickness(THIN_STROKE)

    display.clearScreen()

        ' draw some text!
    display.setTextFont(display.TEXT_FONT_5x7)    ' font size
    display.setCursor(0, 0)   ' start at top left, with one pixel of spacing
    display.setColoredTextAtLnCol(0,0, string("Iron Sheep"), color.cMaroon)
    display.commitScreenToPanelSet()

    ' the 2021 places, as areas (task 170 sizes them from the display); each area fits the 2021 segment length at stroke 1
    _, clkLtWidth, clkLtHeight := counters[GRP_CLOCK_LT].placeGroup(hub75Bffrs.HUB75_ADAPTER_1, 2, 10, 42, 15, counters.GRP_CLOCK, counters.LAYOUT_HH_MM, counters.ROT_0, color.cOrange, 0)

    if maxPhysicalCols > 64
        _, clkRtWidth, clkRtHeight := counters[GRP_CLOCK_RT].placeGroup(hub75Bffrs.HUB75_ADAPTER_1, 66, 8, 42, 15, counters.GRP_CLOCK, counters.LAYOUT_HH_MM, counters.ROT_0, color.cGreen, 12 * 60)

    if maxPhysicalRows > 32
        _, grpDnWidth, grpDnHeight := counters[GRP_DOWNCTR_2DIG].placeGroup(hub75Bffrs.HUB75_ADAPTER_1, 3, 28, 59, 33, counters.GRP_DOWN_COUNTER, counters.LAYOUT_3_DIGITS, counters.ROT_0, color.cTeal, 204)

    if maxPhysicalCols > 64 && maxPhysicalRows > 32
        _, grpRndWidth, grpRndHeight := counters[GRP_CTR_6DIG_RAND].placeGroup(hub75Bffrs.HUB75_ADAPTER_1, 68, 32, 50, 21, counters.GRP_DIGITS_RANDOM, counters.LAYOUT_4_DIGITS, counters.ROT_0, color.cRed, 5436)

    display.commitScreenToPanelSet()
    'repeat

    counters[GRP_CLOCK_LT].setMoveDuration(CLOCK_MOVE_MS)
    counters[GRP_CLOCK_RT].setMoveDuration(CLOCK_MOVE_MS)
    counters[GRP_DOWNCTR_2DIG].setMoveDuration(DOWNCTR_MOVE_MS)
    counters[GRP_CTR_6DIG_RAND].setMoveDuration(RANDOM_MOVE_MS)
    repeat ctrIdx from 0 to LAST_COUNTER
        counters[ctrIdx].setHoldDuration(HOLD_MS)

    timeBase.reset()
    repeat                                                      ' one pass is one frame
        nowMs := timeBase.update()                              ' 1. the frame's time: one counter read, and the frame is counted
        repeat ctrIdx from 0 to LAST_COUNTER                    ' 2. a group whose hold has passed takes its next value
            if counters[ctrIdx].isPlaced() && counters[ctrIdx].isHoldComplete(nowMs)
                counters[ctrIdx].nextTimeCycle()
        repeat ctrIdx from 0 to LAST_COUNTER                    ' 3. every group draws its moves for this frame's time
            counters[ctrIdx].animate(nowMs)
        display.commitScreenToPanelSet()                        ' 4. the one commit: it waits for the driver, so it paces the loop (R-9.2)

    debug("DEMO: done")
    stop()

PRI stop()
    ' Stop the driver
    if cog
        display.stop()
        cog := 0

