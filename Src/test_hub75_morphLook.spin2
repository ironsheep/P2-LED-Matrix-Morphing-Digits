'' =================================================================================================
''
''   File....... test_hub75_morphLook.spin2
''   Purpose.... By-eye check of the stroke look: thin 2021-size digits beside thick ones, flat and tube
''   Authors.... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2026
''   Updated.... 14 Oct 2026
''
'' =================================================================================================

{ Task 180: the look is judged by Stephen's eye (doctrine overlay P1, spec R-4.3). Nothing is checked here; the
  log names each group and where it is. On the quad, 256 x 128:

    top left      the 2021-size clock: stroke 1, a fast clock (the simple demo's first clock)
    top right     a thick HH:MM clock, its stroke sized with its digits, a fast clock
    bottom left   one large digit counting up slowly, flat stroke
    bottom middle the same digit with the tube cross-section
    bottom right  a four-digit counter at stroke 3

  The large digits move slowly (SLOW_MOVE_MS) so each corner and join can be watched as the segments grow and
  shrink. Runs LOOK_MS, then ends the session.
}

CON ' ---- Timing ----

  CLK_FREQ = 335_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

  LOOK_MS = 240_000                                             ' four minutes
  FAST_MOVE_MS = 300
  SLOW_MOVE_MS = 1_500
  SLOW_HOLD_MS = 1_000
  FAST_HOLD_MS = 400
  THIN_STROKE = 1
  COUNTER_STROKE = 3

CON ' ---- Groups ----

  #0, GRP_THIN_CLOCK, GRP_THICK_CLOCK, GRP_BIG_FLAT, GRP_BIG_TUBE, GRP_COUNTER
  NUM_GROUPS = GRP_COUNTER + 1
  LAST_GROUP = NUM_GROUPS - 1
  ' areas: left, top, width, height
  THIN_LEFT = 2
  THIN_TOP = 2
  THIN_WIDTH = 42
  THIN_HEIGHT = 15
  THICK_LEFT = 48
  THICK_TOP = 0
  THICK_WIDTH = 208
  THICK_HEIGHT = 60
  BIG_TOP = 62
  BIG_WIDTH = 64
  BIG_HEIGHT = 66
  BIG_FLAT_LEFT = 0
  BIG_TUBE_LEFT = 64
  COUNTER_LEFT = 132
  COUNTER_TOP = 70
  COUNTER_WIDTH = 124
  COUNTER_HEIGHT = 50
  SEC_PER_MIN = 60
  SEC_PER_HOUR = 60 * SEC_PER_MIN
  START_HOURS = 12                                              ' the clocks start at 12:58: the hours change soon
  START_MINUTES = 58
  CLOCK_START = START_HOURS * SEC_PER_HOUR + START_MINUTES * SEC_PER_MIN

OBJ

    color       : "isp_hub75_color"
    display     : "isp_hub75_display"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    timeBase    : "isp_hub75_morphTime"
    morphMask   : "isp_hub75_morphMask"
    group[NUM_GROUPS] : "isp_hub75_morphCounters"

DAT

    groupNames      word    @nameThin, @nameThick, @nameFlat, @nameTube, @nameCounter
    nameThin        byte    "2021-size clock, stroke 1", 0
    nameThick       byte    "thick clock", 0
    nameFlat        byte    "large digit, flat", 0
    nameTube        byte    "large digit, tube", 0
    nameCounter     byte    "counter, stroke 3", 0

PUB go() | grpIdx, nowMs, startMs

    display.start(display.HUB75_ADAPTER_1)
    display.clearScreen()
    display.commitScreenToPanelSet()

    group[GRP_THIN_CLOCK].setThickness(THIN_STROKE)
    group[GRP_THIN_CLOCK].setClockMode(group.CLOCK_ACCELERATED)
    group[GRP_THICK_CLOCK].setClockMode(group.CLOCK_ACCELERATED)
    group[GRP_BIG_TUBE].setCrossSection(morphMask.SECTION_TUBE)
    group[GRP_COUNTER].setThickness(COUNTER_STROKE)
    repeat grpIdx from 0 to LAST_GROUP
        group[grpIdx].setMoveDuration(FAST_MOVE_MS)
        group[grpIdx].setHoldDuration(FAST_HOLD_MS)
    repeat grpIdx from GRP_BIG_FLAT to GRP_BIG_TUBE
        group[grpIdx].setMoveDuration(SLOW_MOVE_MS)
        group[grpIdx].setHoldDuration(SLOW_HOLD_MS)

    place(GRP_THIN_CLOCK, THIN_LEFT, THIN_TOP, THIN_WIDTH, THIN_HEIGHT, group.GRP_CLOCK, group.LAYOUT_HH_MM, color.cOrange, CLOCK_START)
    place(GRP_THICK_CLOCK, THICK_LEFT, THICK_TOP, THICK_WIDTH, THICK_HEIGHT, group.GRP_CLOCK, group.LAYOUT_HH_MM, color.cOrange, CLOCK_START)
    place(GRP_BIG_FLAT, BIG_FLAT_LEFT, BIG_TOP, BIG_WIDTH, BIG_HEIGHT, group.GRP_UP_COUNTER, group.LAYOUT_1_DIGIT, color.cGreen, 0)
    place(GRP_BIG_TUBE, BIG_TUBE_LEFT, BIG_TOP, BIG_WIDTH, BIG_HEIGHT, group.GRP_UP_COUNTER, group.LAYOUT_1_DIGIT, color.cGreen, 0)
    place(GRP_COUNTER, COUNTER_LEFT, COUNTER_TOP, COUNTER_WIDTH, COUNTER_HEIGHT, group.GRP_UP_COUNTER, group.LAYOUT_4_DIGITS, color.cTeal, 0)
    debug("LOOK     running ", udec_(LOOK_MS / timeBase.MS_PER_SECOND), " s")

    timeBase.reset()
    startMs := timeBase.update()
    nowMs := startMs
    repeat while nowMs - startMs < LOOK_MS
        repeat grpIdx from 0 to LAST_GROUP
            if group[grpIdx].isHoldComplete(nowMs)
                group[grpIdx].nextTimeCycle()
            group[grpIdx].animate(nowMs)
        display.commitScreenToPanelSet()
        nowMs := timeBase.update()
    debug("LOOK     done")
    debug("END_SESSION")

PRI place(grpIdx, left, top, width, height, grpType, layout, rgbColor, value) | status, usedWidth, usedHeight

    status, usedWidth, usedHeight := group[grpIdx].placeGroup(hub75Bffrs.HUB75_ADAPTER_1, left, top, width, height, grpType, layout, group.ROT_0, rgbColor, value)
    debug("LOOK     ", zstr_(@@groupNames[grpIdx]), " in (", udec_(left), ",", udec_(top), ") ", udec_(width), "x", udec_(height), ": status=", sdec_(status), " uses ", udec_(usedWidth), "x", udec_(usedHeight))

