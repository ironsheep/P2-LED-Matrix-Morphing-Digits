'' =================================================================================================
''
''   File....... test_hub75_morphPlace.spin2
''   Purpose.... Board test of placeGroup(): fit and centre in an area, overlap refusal, removal, every refusal
''   Authors.... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2026
''   Updated.... 14 Oct 2026
''
'' =================================================================================================

{ Task 168: proves isp_hub75_morphCounters.placeGroup() and removeGroup() (spec R-8.1-8.7, R-10.1, R-10.2).

  The probe is the screen buffer. A clock showing 20:08 lights its group's whole box: digit 2's lower-left
  vertical sits on the box's left edge, 8's verticals on its right, and the top and bottom segments on its
  top and bottom rows. So the lit pixels' bounding box, read back through pixelAddressAtRC(), is the group as
  drawn: it must have the size placeGroup() returned, and equal margins (within one pixel) inside the area.

  Sections:
    1. a 4-digit HH:MM clock in the whole 256 x 128, and in 128 x 64, 64 x 32 and 32 x 32 areas
    2. a portrait 48 x 128 area at ROT_270; an odd 100 x 37 area; thickness 1 in the whole display; the
       smallest area that places a one-digit group (reported)
    3. refusals, each drawing nothing and changing nothing: area too small, unknown adapter, an area off the
       display, an empty area, unknown type, a layout of the wrong kind, a value out of range, a group already placed
    4. overlap: one pixel of overlap is refused, edge-to-edge is accepted; removeGroup() morphs the group out,
       (placing it again meanwhile is refused), and once it has finished its area can be placed again

  Falsification: compile with -D MORPH_BREAK_PLACE and the expected sizes are taken one pixel wide and the
  "overlapping" area is moved one pixel to touching; the fit and overlap checks must then FAIL.
}

CON ' ---- Timing ----

  CLK_FREQ = 335_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON ' ---- Values and areas ----

  ' The fields of one sizeAreas row (one long each):
  '  AREA_LEFT_IDX   - the area's left column
  '  AREA_TOP_IDX    - the area's top row
  '  AREA_WIDTH_IDX  - the area's width in pixels
  '  AREA_HEIGHT_IDX - the area's height in pixels
  #0, AREA_LEFT_IDX, AREA_TOP_IDX, AREA_WIDTH_IDX, AREA_HEIGHT_IDX
  AREA_FIELDS = AREA_HEIGHT_IDX + 1
  BYTES_PER_LONG = 4

  CLOCK_HOURS = 20                                              ' the clock shows 20:08 ...
  CLOCK_MINUTES = 8
  CLOCK_VALUE = CLOCK_HOURS * groupA.SECONDS_PER_HOUR + CLOCK_MINUTES * groupA.SECONDS_PER_MINUTE  ' ... in seconds: its lit pixels fill the group's box (see above)
  NUM_SIZES = 4
  BAD_ADAPTER = 99
  BAD_TYPE = 99
  OVERLAP_LEFT = 20                                             ' group A's area ...
  OVERLAP_TOP = 20
  OVERLAP_WIDTH = 60
  OVERLAP_HEIGHT = 40
  LAST_OFFSET = 1                                               ' the last index (or pixel) of a count (or size) is the count minus this
  SPAN_EXTRA = 1                                                ' a first-to-last span counts one more than last minus first
  FIRST_SIDE = 1                                                ' the smallest area side the search tries
  THIN_STROKE = 1                                               ' the thinnest stroke
  ONE_SHORT = 1                                                 ' a size one pixel smaller than the best
  JUST_OVER = 1                                                 ' a value one past the highest the group accepts
  CENTRE_SLACK = 1                                              ' centred within this many pixels
  BREAK_PIXELS = 1                                              ' -D MORPH_BREAK_PLACE: the shift that breaks the fit and overlap checks
  DARK_AREA = 0                                                 ' the checksum of an area with nothing lit
  START_MS = 10_000
  STEP_MS = 50
  MAX_REMOVE_STEPS = 100                                        ' a morph-out of 300 ms ends long before this many 50 ms frames
  SMALL_AREA_LIMIT = 16                                         ' the search for the smallest area tries sides up to this
  MAX_FOUR_DIGITS = 9999                                        ' the largest value a four-digit counter accepts
  PORTRAIT_LEFT = 100                                           ' section 2's areas
  PORTRAIT_WIDTH = 48
  ODD_LEFT = 50
  ODD_TOP = 40
  ODD_WIDTH = 100
  ODD_HEIGHT = 37
  SMALL_LEFT = 200                                              ' the smallest-area search, and its neighbours
  SMALL_TOP = 100
  NEIGHBOUR_LEFT = 220
  SMALL_VALUE = 8
  KEEP_WIDTH = 128                                              ' the group kept placed through the refusals
  KEEP_HEIGHT = 64
  REFUSE_TOP = 70                                               ' where the refused areas would have gone
  REFUSE_WIDTH = 100
  REFUSE_HEIGHT = 40
  TINY_WIDTH = 10
  TINY_HEIGHT = 5
  OFF_LEFT = 250
  OFF_WIDTH = 20
  OFF_HEIGHT = 10
  A_VALUE = 88
  C_VALUE = 11

OBJ

    color       : "isp_hub75_color"
    display     : "isp_hub75_display"
    pixels      : "isp_hub75_screenUtils"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    utils       : "test_hub75_morphUtils"
    morphStatus : "isp_hub75_morphStatus"
    groupA      : "isp_hub75_morphCounters"
    groupB      : "isp_hub75_morphCounters"
    groupC      : "isp_hub75_morphCounters"
    probe       : "test_hub75_morphProbe"

DAT ' areas for section 1: left, top, width, height

  sizeAreas       long    0, 0, 256, 128
                  long    64, 32, 128, 64
                  long    96, 48, 64, 32
                  long    112, 48, 32, 32
  sizeNames       word    @nameSize256, @nameSize128, @nameSize64, @nameSize32
  nameSize256     byte    "clock in 256 x 128", 0
  nameSize128     byte    "clock in 128 x 64", 0
  nameSize64      byte    "clock in 64 x 32", 0
  nameSize32      byte    "clock in 32 x 32", 0

VAR

    long    chainIndex
    long    maxRows
    long    maxColumns
    long    nowMs

PUB go() | idx, pArea
'' Run the placement test.
''

' Local Variables:
' @local idx - the section 1 area being tried
' @local pArea - the area's row in sizeAreas

    utils.beginSuite(@"morphPlace placeGroup and removeGroup")
    chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)
    display.start(display.HUB75_ADAPTER_1)
    maxColumns := hub75Bffrs.maxDisplayColumns(chainIndex)
    maxRows := hub75Bffrs.maxDisplayRows(chainIndex)
    nowMs := START_MS

    repeat idx from 0 to NUM_SIZES - LAST_OFFSET
        pArea := @sizeAreas + idx * AREA_FIELDS * BYTES_PER_LONG
        checkFit(@@sizeNames[idx], LONG[pArea][AREA_LEFT_IDX], LONG[pArea][AREA_TOP_IDX], LONG[pArea][AREA_WIDTH_IDX], LONG[pArea][AREA_HEIGHT_IDX], groupA.ROT_0)
    checkFit(@"clock in portrait 48 x 128 at ROT_270", PORTRAIT_LEFT, 0, PORTRAIT_WIDTH, maxRows, groupA.ROT_270)
    checkFit(@"clock in odd 100 x 37", ODD_LEFT, ODD_TOP, ODD_WIDTH, ODD_HEIGHT, groupA.ROT_0)
    groupA.setThickness(THIN_STROKE)
    checkFit(@"clock at thickness 1 in 256 x 128", 0, 0, maxColumns, maxRows, groupA.ROT_0)
    groupA.useAutoThickness()
    removeWaitA()                                               ' A holds the whole display: free it first
    findSmallest()
    checkRefusals()
    checkOverlap()
    display.commitScreenToPanelSet()
    utils.finish()

PRI checkFit(pName, left, top, width, height, groupRotation) | status, usedWidth, usedHeight, litLeft, litTop, litRight, litBottom
' Place the 20:08 clock in an area and read back where its pixels landed.
'
' @param pName - zero-terminated name of the check
' @param left - the area's left column
' @param top - the area's top row
' @param width - the area's width in pixels
' @param height - the area's height in pixels
' @param groupRotation - the group's rotation (groupA.ROT_ value)

' Local Variables:
' @local status - placeGroup()'s result
' @local usedWidth - the width the placed group uses
' @local usedHeight - the height the placed group uses
' @local litLeft - the leftmost lit column
' @local litTop - the topmost lit row
' @local litRight - the rightmost lit column
' @local litBottom - the bottommost lit row

    removeWaitA()                                               ' a placed group refuses placeGroup(): free A first
    display.clearScreen()
    status, usedWidth, usedHeight := groupA.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, left, top, width, height, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, groupRotation, color.cOrange, CLOCK_VALUE)
    frame()
#IFDEF MORPH_BREAK_PLACE
    usedWidth += BREAK_PIXELS
#ENDIF
    litLeft, litTop, litRight, litBottom := probe.litBox(chainIndex, left, top, width, height)
    debug("FIT      ", zstr_(pName), "  status=", sdec_(status), "  used=", udec_(usedWidth), "x", udec_(usedHeight), "  lit=(", sdec_(litLeft), ",", sdec_(litTop), ")-(", sdec_(litRight), ",", sdec_(litBottom), ")")
    utils.checkEqual(status, pName, morphStatus.SUCCESS)
    utils.checkEqual(usedWidth <= width and usedHeight <= height, @"  ... the size used fits the area", TRUE)
    utils.checkEqual(litRight - litLeft + SPAN_EXTRA == usedWidth and litBottom - litTop + SPAN_EXTRA == usedHeight, @"  ... the lit pixels span exactly the size used", TRUE)
    utils.checkEqual(abs ((litLeft - left) - (left + width - LAST_OFFSET - litRight)) <= CENTRE_SLACK and abs ((litTop - top) - (top + height - LAST_OFFSET - litBottom)) <= CENTRE_SLACK, @"  ... centred within one pixel", TRUE)

PRI findSmallest() | status, bestWidth, bestHeight, areaWidth, areaHeight
' Find the smallest area (width by height) that places a one-digit counter: reported, then its neighbours refused.

' Local Variables:
' @local status - placeGroup()'s result
' @local bestWidth - the width of the smallest area that placed (0 until one does)
' @local bestHeight - the height of the smallest area that placed
' @local areaWidth - the area width being tried
' @local areaHeight - the area height being tried

    bestWidth := bestHeight := 0
    repeat areaHeight from FIRST_SIDE to SMALL_AREA_LIMIT
        repeat areaWidth from FIRST_SIDE to SMALL_AREA_LIMIT
            if bestWidth == 0
                status, _, _ := groupB.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, SMALL_LEFT, SMALL_TOP, areaWidth, areaHeight, groupB.GRP_UP_COUNTER, groupB.LAYOUT_1_DIGIT, groupB.ROT_0, color.cGreen, SMALL_VALUE)
                if status == morphStatus.SUCCESS
                    bestWidth := areaWidth
                    bestHeight := areaHeight
    debug("SMALLEST one digit places in ", udec_(bestWidth), " x ", udec_(bestHeight))
    utils.checkEqual(bestWidth * bestHeight > 0, @"smallest area for a one-digit group found (see SMALLEST)", TRUE)
    ' One column narrower, or one row shorter, than the smallest area that placed: the group needs that column or row, so placeGroup() must refuse it
    status, _, _ := groupC.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, NEIGHBOUR_LEFT, SMALL_TOP, bestWidth - ONE_SHORT, bestHeight, groupC.GRP_UP_COUNTER, groupC.LAYOUT_1_DIGIT, groupC.ROT_0, color.cGreen, SMALL_VALUE)
    utils.checkEqual(status, @"  ... one column narrower is too small", morphStatus.E_AREA_TOO_SMALL)
    status, _, _ := groupC.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, NEIGHBOUR_LEFT, SMALL_TOP, bestWidth, bestHeight - ONE_SHORT, groupC.GRP_UP_COUNTER, groupC.LAYOUT_1_DIGIT, groupC.ROT_0, color.cGreen, SMALL_VALUE)
    utils.checkEqual(status, @"  ... one row shorter is too small", morphStatus.E_AREA_TOO_SMALL)
    removeWaitB()

PRI checkRefusals() | beforeSum
' Check that every bad placeGroup() call is refused with its own status, and that a refusal draws and changes nothing.

' Local Variables:
' @local beforeSum - the screen checksum before the refused calls

    ' Group A stays placed through every refused call. Each refuse() below is expected to fail with the status it
    ' names: the area is too small for the clock, the adapter is unknown, the area is off the display or empty, the
    ' type or layout is unknown, the value is out of range (a four-digit counter holds up to 9999, a clock up to
    ' 23:59:59), or the group is already placed.
    display.clearScreen()
    groupA.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, 0, 0, KEEP_WIDTH, KEEP_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, groupA.ROT_0, color.cOrange, CLOCK_VALUE)
    frame()
    beforeSum := screenSum()
    refuse(@"refuse an area too small (clock in 10 x 5)", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, TINY_WIDTH, TINY_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, CLOCK_VALUE, morphStatus.E_AREA_TOO_SMALL)
    refuse(@"refuse an unknown adapter", BAD_ADAPTER, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, CLOCK_VALUE, morphStatus.E_UNKNOWN_ADAPTER)
    refuse(@"refuse an area off the display", hub75Bffrs.HUB75_ADAPTER_1, OFF_LEFT, REFUSE_TOP, OFF_WIDTH, OFF_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, CLOCK_VALUE, morphStatus.E_BAD_AREA)
    refuse(@"refuse an empty area", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, 0, OFF_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, CLOCK_VALUE, morphStatus.E_BAD_AREA)
    refuse(@"refuse an unknown type", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, BAD_TYPE, groupA.LAYOUT_4_DIGITS, 0, morphStatus.E_UNKNOWN_TYPE)
    refuse(@"refuse a clock with a digits layout", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_4_DIGITS, 0, morphStatus.E_UNKNOWN_LAYOUT)
    refuse(@"refuse a counter with a clock layout", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, groupA.GRP_UP_COUNTER, groupA.LAYOUT_HH_MM, 0, morphStatus.E_UNKNOWN_LAYOUT)
    refuse(@"refuse 10000 on four digits", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, groupA.GRP_UP_COUNTER, groupA.LAYOUT_4_DIGITS, MAX_FOUR_DIGITS + JUST_OVER, morphStatus.E_VALUE_OUT_OF_RANGE)
    refuse(@"refuse 24:00:00 on a clock", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, groupA.MAX_DAY_SECONDS + JUST_OVER, morphStatus.E_VALUE_OUT_OF_RANGE)
    refuse(@"refuse placing a placed group in a free area", hub75Bffrs.HUB75_ADAPTER_1, 0, REFUSE_TOP, REFUSE_WIDTH, REFUSE_HEIGHT, groupA.GRP_CLOCK, groupA.LAYOUT_HH_MM, CLOCK_VALUE, morphStatus.E_ALREADY_PLACED)
    redraw()                                                    ' the same time: a real-time clock's colon must not pulse between the sums
    utils.checkEqual(screenSum(), @"  ... the refused calls drew nothing and moved nothing", beforeSum)
    frame()
    utils.checkEqual(groupA.isPlaced(), @"  ... and the group is still placed", TRUE)
    utils.checkEqual(groupC.removeGroup(), @"removeGroup refuses a group that is not placed", morphStatus.E_NOT_PLACED)
    removeWaitA()

PRI refuse(pName, adapter, left, top, width, height, grpType, layout, groupValue, expectedStatus) | status
' Try to place group A with arguments that must be refused, and check the status placeGroup() gives.
'
' @param pName - zero-terminated name of the check
' @param adapter - the adapter id to place on
' @param left - the area's left column
' @param top - the area's top row
' @param width - the area's width in pixels
' @param height - the area's height in pixels
' @param grpType - the group type (groupA.GRP_ value)
' @param layout - the digit layout (groupA.LAYOUT_ value)
' @param groupValue - the group's first value
' @param expectedStatus - the refusal status the check requires

' Local Variables:
' @local status - placeGroup()'s result

    status, _, _ := groupA.placeGroup(adapter, left, top, width, height, grpType, layout, groupA.ROT_0, color.cOrange, groupValue)
    utils.checkEqual(status, pName, expectedStatus)

PRI checkOverlap() | status, sumB, overlapLeft
' Check the overlap rule: one pixel of overlap is refused, edge-to-edge is accepted, and a morphing-out group still holds its area.

' Local Variables:
' @local status - placeGroup()'s result
' @local sumB - the checksum of the area group B was refused in
' @local overlapLeft - the left edge of group B's overlapping area

    display.clearScreen()
    status, _, _ := groupA.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, OVERLAP_LEFT, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupA.GRP_UP_COUNTER, groupA.LAYOUT_2_DIGITS, groupA.ROT_0, color.cOrange, A_VALUE)
    frame()
    utils.checkEqual(status, @"group A placed", morphStatus.SUCCESS)
    overlapLeft := OVERLAP_LEFT + OVERLAP_WIDTH - LAST_OFFSET        ' shares A's right column
#IFDEF MORPH_BREAK_PLACE
    overlapLeft += BREAK_PIXELS
#ENDIF
    sumB := areaSum(overlapLeft, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT)
    status, _, _ := groupB.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, overlapLeft, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupB.GRP_UP_COUNTER, groupB.LAYOUT_2_DIGITS, groupB.ROT_0, color.cGreen, A_VALUE)
    frame()
    utils.checkEqual(status, @"group B overlapping A by one column is refused", morphStatus.E_AREA_OVERLAP)
    utils.checkEqual(areaSum(overlapLeft, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT), @"  ... and drew nothing", sumB)
    utils.checkEqual(groupB.isPlaced(), @"  ... and is not placed", FALSE)
    status, _, _ := groupB.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, OVERLAP_LEFT + OVERLAP_WIDTH, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupB.GRP_UP_COUNTER, groupB.LAYOUT_2_DIGITS, groupB.ROT_0, color.cGreen, A_VALUE)
    frame()
    utils.checkEqual(status, @"group B touching A edge to edge is placed", morphStatus.SUCCESS)
    ' Group C asks for A's whole area while A holds it: refused as an overlap
    status, _, _ := groupC.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, OVERLAP_LEFT, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupC.GRP_UP_COUNTER, groupC.LAYOUT_2_DIGITS, groupC.ROT_0, color.cTeal, C_VALUE)
    utils.checkEqual(status, @"group C in A's area while A is placed is refused", morphStatus.E_AREA_OVERLAP)
    utils.checkEqual(groupA.removeGroup(), @"removeGroup starts A's morph-out", morphStatus.SUCCESS)
    oneFrame()                                                  ' one frame: A is mid morph-out
    ' A morphing-out group keeps its area until the morph ends, so C is still refused as an overlap
    status, _, _ := groupC.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, OVERLAP_LEFT, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupC.GRP_UP_COUNTER, groupC.LAYOUT_2_DIGITS, groupC.ROT_0, color.cTeal, C_VALUE)
    utils.checkEqual(status, @"  ... C is still refused while A morphs out", morphStatus.E_AREA_OVERLAP)
    ' A is not yet free (its morph-out is still running), so placing A again is refused as already placed
    status, _, _ := groupA.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, OVERLAP_LEFT, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupA.GRP_UP_COUNTER, groupA.LAYOUT_2_DIGITS, groupA.ROT_0, color.cOrange, A_VALUE)
    utils.checkEqual(status, @"  ... and so is placing A again while it morphs out", morphStatus.E_ALREADY_PLACED)
    waitRemovedA()
    utils.checkEqual(groupA.isPlaced(), @"  ... A's morph-out completes and frees its area", FALSE)
    utils.checkEqual(areaSum(OVERLAP_LEFT, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT), @"  ... and leaves A's area dark", DARK_AREA)
    status, _, _ := groupC.placeGroup(hub75Bffrs.HUB75_ADAPTER_1, OVERLAP_LEFT, OVERLAP_TOP, OVERLAP_WIDTH, OVERLAP_HEIGHT, groupC.GRP_UP_COUNTER, groupC.LAYOUT_2_DIGITS, groupC.ROT_0, color.cTeal, C_VALUE)
    utils.checkEqual(status, @"  ... then C places in the freed area", morphStatus.SUCCESS)
    removeWaitB()
    removeWaitC()

PRI removeWaitA()
' Remove group A and animate until its morph-out completes (Spin2 cannot pass an object, so one per group).

    groupA.removeGroup()
    waitRemovedA()

PRI removeWaitB() | steps
' Remove group B and animate until its morph-out completes (or MAX_REMOVE_STEPS frames).

' Local Variables:
' @local steps - frames drawn while waiting

    groupB.removeGroup()
    steps := 0
    repeat while groupB.isPlaced() and steps++ < MAX_REMOVE_STEPS
        oneFrame()

PRI removeWaitC() | steps
' Remove group C and animate until its morph-out completes (or MAX_REMOVE_STEPS frames).

' Local Variables:
' @local steps - frames drawn while waiting

    groupC.removeGroup()
    steps := 0
    repeat while groupC.isPlaced() and steps++ < MAX_REMOVE_STEPS
        oneFrame()

PRI waitRemovedA() | steps
' Animate until group A's morph-out completes (or MAX_REMOVE_STEPS frames; the check after it reports which).

' Local Variables:
' @local steps - frames drawn while waiting

    steps := 0
    repeat while groupA.isPlaced() and steps++ < MAX_REMOVE_STEPS
        oneFrame()

PRI oneFrame()
' Draw every group once at the next frame time.

    nowMs += STEP_MS
    redraw()

PRI redraw()
' Draw every group at the current frame time (time does not advance).

    groupA.animate(nowMs)
    groupB.animate(nowMs)
    groupC.animate(nowMs)

PRI frame() | steps
' Draw every group at the next frame times until every move has ended (placement grows the digits in).

' Local Variables:
' @local steps - frames drawn so far (the loop gives up at MAX_REMOVE_STEPS)

    steps := 0
    repeat
        nowMs += STEP_MS
        groupA.animate(nowMs)
        groupB.animate(nowMs)
        groupC.animate(nowMs)
    until (groupA.isAnimationComplete() and groupB.isAnimationComplete() and groupC.isAnimationComplete()) or ++steps > MAX_REMOVE_STEPS

PRI areaSum(left, top, width, height) : checksum
' Compute the checksum of an area of the screen.
'
' @param left - the area's left column
' @param top - the area's top row
' @param width - the area's width in pixels
' @param height - the area's height in pixels
' @returns checksum - the area's pixel checksum: equal areas give equal sums

    checksum := probe.areaChecksum(chainIndex, left, top, width, height)

PRI screenSum() : checksum
' Compute the checksum of the whole display.
'
' @returns checksum - the display's pixel checksum: equal screens give equal sums

    checksum := areaSum(0, 0, maxColumns, maxRows)

CON ' ---- License ----

