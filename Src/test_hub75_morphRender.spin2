'' =================================================================================================
''
''   File....... test_hub75_morphRender.spin2
''   Purpose.... Board test of the segment renderer: every transition ends on the rest pixels, refusals, edges, timing
''   Authors.... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... Oct 2026
''   Updated.... 14 Oct 2026
''
'' =================================================================================================

{ Task 166: proves the renderer (isp_hub75_morph7seg drawing, isp_hub75_morphSegment motion) on the quad.

  The probe is the screen buffer: a checksum of every byte of the digit's area, read back through
  screenUtils.pixelAddressAtRC(). "At rest" is the digit placed fresh with a value: its segments snake on
  as it grows in, then rests. Every transition must end on exactly those pixels (spec R-5.7).

  Sections:
    1. per configuration (thin edge profile, thick tail profile, thick tube with a tail longer than the
       segment): the rest checksum of each digit 0-9, then all 90 transitions from rest, each
       sampled mid-move (it must differ from the end) and at its end (it must equal the rest checksum)
    2. an interrupted move: a new value mid-flight still ends on the new value's rest pixels (R-5.5)
    3. the column slides in both directions on and off, including the two the table never uses
    4. refused commands: a style the segment cannot do changes nothing on the screen
    5. a digit touching the display's right and bottom edges
    6. timing: one segment's frames per profile, and a dense frame of six thick digits all moving
    7. the figure's area (spec R-4.3): digits 0 and 1 at rest, read through a ramp whose red byte is the level,
       against the round-pen figure's area by formula, within 1%. With P = L + 1 and corner radius
       R = (T + 1) / 2, a 0 is one closed loop of centre-line length 6P - 8R + 2 pi R, so its area is T times
       that; a 1 is one straight stroke with round ends, T (2P - T - 1) + pi T^2 / 4. Strokes 5 and 4 (odd
       and even: the even one's runs start half a pixel in).

  Falsification: compile with -D MORPH_BREAK_RENDER and the renderer's end state is damaged (one mask
  byte changes after the rest checksums are taken); every end-equals-rest check must then FAIL.
}

CON ' ---- Timing ----

  CLK_FREQ = 335_000_000                                        ' system freq as a constant
  _clkfreq = CLK_FREQ                                           ' set system clock

CON ' ---- Digit under test ----

  DIGIT_ROW = 4
  DIGIT_COLUMN = 4
  MOVE_MS = 300
  MID_MS = MOVE_MS / 2
  START_MS = 1000                                               ' injected frame times start here (only differences count)
  GAP_MS = 1000                                                 ' each transition starts this far after the previous one
  NUM_DIGITS = 10
  LAST_DIGIT_VALUE = NUM_DIGITS - 1
  NUM_TRANSITIONS = NUM_DIGITS * (NUM_DIGITS - 1)
  MASK_BYTES = 2048
  SEGMENT_EXTRA = 1                                             ' a segment's head runs L + 1 pixels (P = L + 1)
  ODD_BIT = 1                                                   ' stroke & ODD_BIT is set for an odd stroke
  LINEAR_EASING = 0                                             ' setMotion()'s easing style for a linear move (EASE_LINEAR)
  TAIL_UNIT_X256 = 256                                          ' one pixel of tail, in 1/256 px
  NO_MISMATCHES = 0                                             ' the expected count of transitions that miss the rest pixels
  BLANK_CHECKSUM = 0                                            ' the checksum of an all-black area
  BREAK_BITS = $FF                                              ' -D MORPH_BREAK_RENDER: XOR-ed into the mask byte, flipping every bit
  BREAK_BYTE = 3                                                ' -D MORPH_BREAK_RENDER: the index of the mask byte that is changed after the rest checksums

CON ' ---- Configurations ----

  NUM_CONFIGS = 3
  ' thin: thickness 1, length 6, square, flat, edge profile (the 2021 look)
  ' thick: thickness 5, length 20, flat, tail profile (tail 5)
  ' tube: thickness 8, length 24, tube, tail 40 (longer than the segment)
  EDGE_TAIL_X256 = TAIL_UNIT_X256
  THICK_CONFIG = 1                                              ' the configuration the single cases use
  NUM_PROFILES = 2                                              ' the timing section's profiles: edge, then tail

CON ' ---- Slides, refusals, edges ----

  INTERRUPT_FROM = 1
  INTERRUPT_VIA = 7
  INTERRUPT_TO = 3
  EDGE_FROM = 8
  EDGE_TO = 0

CON ' ---- Timing section ----

  TIMED_THICKNESS = 9
  TIMED_LENGTH = 40
  TIMED_TAIL_X256 = 10 * TAIL_UNIT_X256
  TIMED_FRAMES = 20
  FRAME_STEP_MS = MOVE_MS / TIMED_FRAMES
  DENSE_DIGITS = 6
  DENSE_THICKNESS = 6
  DENSE_LENGTH = 22
  DENSE_GAP = 4
  DENSE_ROW = 40
  DENSE_FROM = 8                                                ' 8 -> 1: A, D, E, F and G all snake or slide off at once
  DENSE_TO = 1

CON ' ---- Figure area ----

  AREA_ODD_THICKNESS = 5
  AREA_ODD_LENGTH = 20
  AREA_EVEN_THICKNESS = 4
  AREA_EVEN_LENGTH = 30
  AREA_ZERO = 0
  AREA_ONE = 1
  CORNERS_PER_LOOP = 8                                          ' a loop's straight runs lose 2R at each of 4 corners ...
  SIDES_PER_LOOP = 6                                            ' ... of 6 sides' worth of P (2 across, 2 x 2 down)
  TENTHS = 10                                                   ' areas are compared in tenths of a pixel
  PERCENT_WHOLE = 100                                           ' within 1%
  HALF_DIVISOR = 2                                              ' adds half a step before dividing, to round to nearest
  F_PI = 3.14159265
  F_TWO = 2.0
  F_QUARTER = 4.0
  F_TENTHS = 10.0

OBJ

    color       : "isp_hub75_color"
    display     : "isp_hub75_display"
    pixels      : "isp_hub75_screenUtils"
    hub75Bffrs  : "isp_hub75_hwBufferAccess"
    utils       : "test_hub75_morphUtils"
    morphColor  : "isp_hub75_morphColor"
    morphMask   : "isp_hub75_morphMask"
    morphStatus : "isp_hub75_morphStatus"
    digit       : "isp_hub75_morph7seg"
    seg         : "isp_hub75_morphSegment"                  ' command constants only
    probe       : "test_hub75_morphProbe"
    dense[DENSE_DIGITS] : "isp_hub75_morph7seg"

DAT ' configurations: thickness, length, cross-section, tail (1/256 px), name

  configThickness long    1, 5, 8
  configLength    long    6, 20, 24
  configSection   long    morphMask.SECTION_FLAT, morphMask.SECTION_FLAT, morphMask.SECTION_TUBE
  configTail      long    EDGE_TAIL_X256, 5 * TAIL_UNIT_X256, 40 * TAIL_UNIT_X256
  configNames     word    @nameThin, @nameThick, @nameTube
  nameThin        byte    "thin T1 L6 edge", 0
  nameThick       byte    "thick T5 L20 tail5", 0
  nameTube        byte    "tube T8 L24 tail40", 0

VAR

    long    chainIndex
    long    maxRows
    long    maxColumns
    long    nowMs
    long    thickness
    long    segmentLength
    long    tailX256
    long    areaWidth
    long    areaHeight
    long    restSum[NUM_DIGITS]
    long    ramp[morphColor.RAMP_LEVELS]
    long    linearRamp[morphColor.RAMP_LEVELS]                  ' the area probe's ramp: red byte = level
    byte    mask[MASK_BYTES]

PUB go() | cfgIdx
'' Run the renderer test: start the display, each configuration's transitions, then the single cases and timing.
''

' Local Variables:
' @local cfgIdx - the configuration being run

    utils.beginSuite(@"morphRender segment renderer")
    chainIndex := hub75Bffrs.indexForHub75ChainId(hub75Bffrs.HUB75_ADAPTER_1)
    display.start(display.HUB75_ADAPTER_1)
    maxColumns := hub75Bffrs.maxDisplayColumns(chainIndex)
    maxRows := hub75Bffrs.maxDisplayRows(chainIndex)
    morphColor.buildRamp(@ramp, chainIndex, color.cOrange)
    digit.initialize(chainIndex, maxRows, maxColumns)
    nowMs := START_MS

    repeat cfgIdx from 0 to NUM_CONFIGS - morphMask.LAST_OFFSET
        useConfig(cfgIdx)
        checkTransitions(@@configNames[cfgIdx])
    useConfig(THICK_CONFIG)
    checkInterrupt()
    checkSlides()
    checkRefusals()
    checkDisplayEdge()
    checkTiming()
    checkFigureArea(AREA_ODD_THICKNESS, AREA_ODD_LENGTH)
    checkFigureArea(AREA_EVEN_THICKNESS, AREA_EVEN_LENGTH)
    display.commitScreenToPanelSet()
    utils.finish()

PRI useConfig(cfgIdx) | status
' Select a configuration: set its thickness, length and tail, build its figure and size the digit's area.
'
' @param cfgIdx - the configuration's index (0 to NUM_CONFIGS - 1)

' Local Variables:
' @local status - buildFigure()'s result

    thickness := configThickness[cfgIdx]
    segmentLength := configLength[cfgIdx]
    tailX256 := configTail[cfgIdx]
    status := morphMask.buildFigure(@mask, MASK_BYTES, thickness, segmentLength, thickness, configSection[cfgIdx])
    areaWidth, areaHeight := digit.digitSize(segmentLength, thickness)
    debug("CONFIG   ", zstr_(@@configNames[cfgIdx]), "  status=", sdec_(status), "  digit=", udec_(areaWidth), "x", udec_(areaHeight))

PRI checkTransitions(pName) | fromValue, toValue, endMismatches, midSame, midSum
' Check all 90 transitions from rest: each must differ from the end mid-move and equal the rest checksum at its end.
'
' @param pName - zero-terminated name of the check

' Local Variables:
' @local fromValue - the digit the transition starts from
' @local toValue - the digit the transition goes to
' @local endMismatches - how many transitions ended off the rest pixels
' @local midSame - how many transitions looked finished at mid-move
' @local midSum - the area checksum at mid-move

    ' the rest pixels of each digit, placed fresh (segments on at once)
    repeat fromValue from 0 to LAST_DIGIT_VALUE
        placeAt(DIGIT_ROW, DIGIT_COLUMN, fromValue)
        restSum[fromValue] := areaSum(DIGIT_ROW, DIGIT_COLUMN)
#IFDEF MORPH_BREAK_RENDER
    mask[BREAK_BYTE] ^= BREAK_BITS
#ENDIF
    endMismatches := 0
    midSame := 0
    repeat fromValue from 0 to LAST_DIGIT_VALUE
        repeat toValue from 0 to LAST_DIGIT_VALUE
            if toValue <> fromValue
                placeAt(DIGIT_ROW, DIGIT_COLUMN, fromValue)
                digit.setValue(toValue)
                frame(0)                                            ' stamps the moves' start
                frame(MID_MS)
                midSum := areaSum(DIGIT_ROW, DIGIT_COLUMN)
                frame(MOVE_MS - MID_MS)
                if areaSum(DIGIT_ROW, DIGIT_COLUMN) <> restSum[toValue]
                    endMismatches++
                    debug("MISMATCH ", zstr_(pName), "  ", udec_(fromValue), " -> ", udec_(toValue))
                if midSum == restSum[toValue]
                    midSame++
#IFDEF MORPH_BREAK_RENDER
    mask[BREAK_BYTE] ^= BREAK_BITS
#ENDIF
    debug("TRANS    ", zstr_(pName), "  ran=", udec_(NUM_TRANSITIONS), "  end_mismatches=", udec_(endMismatches), "  mid_equal_end=", udec_(midSame))
    utils.checkEqual(endMismatches, pName, NO_MISMATCHES)
    utils.checkEqual(midSame, @"  ... and mid-move differs from the end in every transition", NO_MISMATCHES)

PRI checkInterrupt()
' Check that a new value mid-flight still ends on the new value's rest pixels (1 -> 7, interrupted by 3).

    placeAt(DIGIT_ROW, DIGIT_COLUMN, INTERRUPT_TO)
    restSum[INTERRUPT_TO] := areaSum(DIGIT_ROW, DIGIT_COLUMN)
    placeAt(DIGIT_ROW, DIGIT_COLUMN, INTERRUPT_FROM)
    digit.setValue(INTERRUPT_VIA)
    frame(0)
    frame(MID_MS)
    digit.setValue(INTERRUPT_TO)                                    ' mid-flight: the 1 -> 7 moves snap to their end first
    frame(0)
    frame(MOVE_MS)
    utils.checkEqual(areaSum(DIGIT_ROW, DIGIT_COLUMN), @"interrupted 1 -> 7 -> 3 ends on 3's rest pixels", restSum[INTERRUPT_TO])

PRI checkSlides() | blankSum, eOnlySum
' Check the column slides of segment E in both directions, on and off, including the two the table never uses.

' Local Variables:
' @local blankSum - the checksum of the hidden digit's area
' @local eOnlySum - the checksum of the area with only segment E at home

    placeAt(DIGIT_ROW, DIGIT_COLUMN, digit.DIGIT_HIDDEN)
    blankSum := areaSum(DIGIT_ROW, DIGIT_COLUMN)
    utils.checkEqual(blankSum, @"a hidden digit's area is black (checksum 0)", BLANK_CHECKSUM)
    digit.commandSegment(digit.SLOT_E, seg.CMD_TURN_ON + seg.CMD_IMMEDIATE)
    frame(0)
    eOnlySum := areaSum(DIGIT_ROW, DIGIT_COLUMN)
    slideCase(digit.SLOT_E, seg.CMD_TURN_OFF + seg.CMD_COL_TO_RT, blankSum, @"E slides off to the right (table): ends blank")
    slideCase(digit.SLOT_E, seg.CMD_TURN_ON + seg.CMD_COL_TO_LT, eOnlySum, @"E slides on from the right (table): ends at home")
    slideCase(digit.SLOT_E, seg.CMD_TURN_OFF + seg.CMD_COL_TO_LT, blankSum, @"E slides off to the left (unused): ends blank")
    slideCase(digit.SLOT_E, seg.CMD_TURN_ON + seg.CMD_COL_TO_RT, eOnlySum, @"E slides on from the left (unused): ends at home")

PRI slideCase(slot, command, expectedSum, pName)
' Run one slide command through a whole move and check the area ends on the expected checksum.
'
' @param slot - the segment's slot (digit.SLOT_ value)
' @param command - the segment command: a turn on or off, with its style
' @param expectedSum - the checksum the area must end on
' @param pName - zero-terminated name of the check

    utils.checkEqual(digit.commandSegment(slot, command), @"  slide command accepted", morphStatus.SUCCESS)
    frame(0)
    frame(MID_MS)
    frame(MOVE_MS - MID_MS)
    utils.checkEqual(areaSum(DIGIT_ROW, DIGIT_COLUMN), pName, expectedSum)

PRI checkRefusals() | beforeSum
' Check that commands the segment cannot do are refused and change nothing on the screen.

' Local Variables:
' @local beforeSum - the checksum of the area before the refused commands

    placeAt(DIGIT_ROW, DIGIT_COLUMN, EDGE_FROM)
    beforeSum := areaSum(DIGIT_ROW, DIGIT_COLUMN)
    ' each of these styles is one the segment cannot do (a horizontal snake on a vertical, a column slide on a right
    ' vertical, a vertical snake on a horizontal, a style nothing defines): commandSegment() must refuse it with E_BAD_COMMAND
    refuse(digit.SLOT_B, seg.CMD_TURN_OFF + seg.CMD_LT_TO_RT, @"refuse LT_TO_RT on vertical B")
    refuse(digit.SLOT_C, seg.CMD_TURN_OFF + seg.CMD_COL_TO_RT, @"refuse a column slide on C")
    refuse(digit.SLOT_A, seg.CMD_TURN_OFF + seg.CMD_TOP_DOWN, @"refuse TOP_DOWN on horizontal A")
    refuse(digit.SLOT_G, seg.CMD_TURN_OFF + seg.CMD_UNKNOWN, @"refuse an unknown style on G")
    frame(0)
    frame(MOVE_MS)
    utils.checkEqual(areaSum(DIGIT_ROW, DIGIT_COLUMN), @"  ... and the refused commands drew nothing", beforeSum)

PRI refuse(slot, command, pName)
' Check that commandSegment() refuses a command with E_BAD_COMMAND.
'
' @param slot - the segment's slot (digit.SLOT_ value)
' @param command - the segment command: a turn on or off, with its style
' @param pName - zero-terminated name of the check

    utils.checkEqual(digit.commandSegment(slot, command), pName, morphStatus.E_BAD_COMMAND)

PRI checkDisplayEdge() | row, column, restEdgeSum
' Check a digit touching the display's right and bottom edges: 8 -> 0 ends on 0's rest pixels.

' Local Variables:
' @local row - the digit area's top row
' @local column - the digit area's left column
' @local restEdgeSum - the checksum of 0 placed fresh at the edge

    row := maxRows - areaHeight
    column := maxColumns - areaWidth
    placeAt(row, column, EDGE_TO)
    restEdgeSum := areaSum(row, column)
    placeAt(row, column, EDGE_FROM)
    digit.setValue(EDGE_TO)
    frame(0)
    frame(MID_MS)
    frame(MOVE_MS - MID_MS)
    utils.checkEqual(areaSum(row, column), @"a digit touching the right and bottom edges: 8 -> 0 ends on 0's rest pixels", restEdgeSum)
    clearArea(row, column)

PRI checkTiming() | startTick, ticks, digitIdx, column, profileIdx
' Time one segment's frames per profile, then a dense frame of six thick digits all moving, and report each average.

' Local Variables:
' @local startTick - the system counter when the frame began
' @local ticks - the system counter ticks summed over the timed frames
' @local digitIdx - the dense digit being set up or animated
' @local column - the left column of the next dense digit
' @local profileIdx - the profile being timed (0 edge, 1 tail)

    morphMask.buildFigure(@mask, MASK_BYTES, TIMED_THICKNESS, TIMED_LENGTH, TIMED_THICKNESS, morphMask.SECTION_FLAT)
    repeat profileIdx from 0 to NUM_PROFILES - morphMask.LAST_OFFSET
        tailX256 := profileIdx == 0 ? EDGE_TAIL_X256 : TIMED_TAIL_X256
        thickness := TIMED_THICKNESS
        segmentLength := TIMED_LENGTH
        placeAt(DIGIT_ROW, DIGIT_COLUMN, digit.DIGIT_HIDDEN)
        digit.commandSegment(digit.SLOT_A, seg.CMD_TURN_ON + seg.CMD_LT_TO_RT)
        frame(0)
        ticks := 0
        repeat TIMED_FRAMES - morphMask.LAST_OFFSET
            nowMs += FRAME_STEP_MS
            startTick := getct()
            digit.animate(nowMs)
            ticks += getct() - startTick
        debug("TIME     one segment (T9 L40) per frame, ", zstr_(profileIdx == 0 ? @"edge profile" : @"tail profile 10"), "  avg_us=", udec_(muldiv64(ticks / (TIMED_FRAMES - morphMask.LAST_OFFSET), utils.MICROS_PER_SECOND, clkfreq)))
    clearArea(DIGIT_ROW, DIGIT_COLUMN)

    morphMask.buildFigure(@mask, MASK_BYTES, DENSE_THICKNESS, DENSE_LENGTH, DENSE_THICKNESS, morphMask.SECTION_FLAT)
    column := DIGIT_COLUMN
    repeat digitIdx from 0 to DENSE_DIGITS - morphMask.LAST_OFFSET
        dense[digitIdx].initialize(chainIndex, maxRows, maxColumns)
        areaWidth, areaHeight := dense[digitIdx].placeDigit(DENSE_ROW, column, DENSE_LENGTH, DENSE_THICKNESS, DENSE_FROM, @mask, @ramp, TIMED_TAIL_X256)
        dense[digitIdx].setMotion(MOVE_MS, LINEAR_EASING)
        dense[digitIdx].animate(nowMs)
        column += areaWidth + DENSE_GAP
    repeat digitIdx from 0 to DENSE_DIGITS - morphMask.LAST_OFFSET
        dense[digitIdx].setValue(DENSE_TO)
        dense[digitIdx].animate(nowMs)
    ticks := 0
    repeat TIMED_FRAMES - morphMask.LAST_OFFSET
        nowMs += FRAME_STEP_MS
        startTick := getct()
        repeat digitIdx from 0 to DENSE_DIGITS - morphMask.LAST_OFFSET
            dense[digitIdx].animate(nowMs)
        ticks += getct() - startTick
    debug("TIME     dense frame: 6 digits T6 L22 (8 -> 1, 5 segments each) all moving, tail 10  avg_us=", udec_(muldiv64(ticks / (TIMED_FRAMES - morphMask.LAST_OFFSET), utils.MICROS_PER_SECOND, clkfreq)))

PRI checkFigureArea(stroke, length) | level, expectedX10, measuredX10, fT, fP, fR
' Check digits 0 and 1 at rest cover the round-pen figure's area by formula, within 1% (spec R-4.3).
'
' @param stroke - the stroke thickness in pixels
' @param length - the segment length in pixels

' Local Variables:
' @local level - the ramp level being filled in (its red byte is the level)
' @local expectedX10 - the area by formula, in tenths of a pixel
' @local measuredX10 - the area read back, in tenths of a pixel
' @local fT - the stroke thickness, as a float
' @local fP - the segment length plus one, as a float
' @local fR - the corner radius, as a float

    repeat level from 0 to morphColor.RAMP_MAX
        linearRamp[level] := pixels.packedCorrectedRgb(chainIndex, level, 0, 0)
    morphMask.buildFigure(@mask, MASK_BYTES, stroke, length, stroke, morphMask.SECTION_FLAT)
    thickness := stroke
    segmentLength := length
    tailX256 := EDGE_TAIL_X256
    areaWidth, areaHeight := digit.digitSize(segmentLength, thickness)
    fT := float(stroke)
    fP := float(length + SEGMENT_EXTRA)
    fR := (fT +. morphMask.F_ONE) *. morphMask.F_HALF

    placeLinear(AREA_ZERO)
    measuredX10 := redTenths()
    expectedX10 := round(F_TENTHS *. fT *. (float(SIDES_PER_LOOP) *. fP -. float(CORNERS_PER_LOOP) *. fR +. F_TWO *. F_PI *. fR))
    debug("AREA     0 at T", udec_(stroke), " L", udec_(length), "  measured_x10=", udec_(measuredX10), "  expected_x10=", udec_(expectedX10))
    utils.checkEqual(abs (measuredX10 - expectedX10) * PERCENT_WHOLE <= expectedX10, stroke & ODD_BIT ? @"a 0 (odd stroke) covers its round-pen loop's area within 1%" : @"a 0 (even stroke) covers its round-pen loop's area within 1%", TRUE)

    placeLinear(AREA_ONE)
    measuredX10 := redTenths()
    expectedX10 := round(F_TENTHS *. (fT *. (F_TWO *. fP -. fT -. morphMask.F_ONE) +. F_PI *. fT *. fT /. F_QUARTER))
    debug("AREA     1 at T", udec_(stroke), " L", udec_(length), "  measured_x10=", udec_(measuredX10), "  expected_x10=", udec_(expectedX10))
    utils.checkEqual(abs (measuredX10 - expectedX10) * PERCENT_WHOLE <= expectedX10, stroke & ODD_BIT ? @"a 1 (odd stroke) covers its round-ended stroke's area within 1%" : @"a 1 (even stroke) covers its round-ended stroke's area within 1%", TRUE)
    clearArea(DIGIT_ROW, DIGIT_COLUMN)

PRI placeLinear(digitValue)
' Place the digit fresh through the linear ramp, showing digitValue at rest.
'
' @param digitValue - the digit to show (0 to 9, or digit.DIGIT_HIDDEN)

    clearArea(DIGIT_ROW, DIGIT_COLUMN)
    digit.placeDigit(DIGIT_ROW, DIGIT_COLUMN, segmentLength, thickness, digitValue, @mask, @linearRamp, tailX256)
    digit.setMotion(MOVE_MS, LINEAR_EASING)
    frame(0)
    frame(MOVE_MS)

PRI redTenths() : amountX10 | pixRow, pixCol, pPixel, total
' Sum the digit area's lit amount, in tenths of a pixel: its red bytes (the level, through the linear ramp) / 255.
'
' @returns amountX10 - the lit amount, in tenths of a pixel
'
' Local Variables:
' @local pixRow - the pixel row being read
' @local pixCol - the pixel column being read
' @local pPixel - the address of the pixel being read
' @local total - the sum of the red bytes

    total := 0
    repeat pixRow from DIGIT_ROW to DIGIT_ROW + areaHeight - morphMask.LAST_OFFSET
        repeat pixCol from DIGIT_COLUMN to DIGIT_COLUMN + areaWidth - morphMask.LAST_OFFSET
            pPixel := pixels.pixelAddressAtRC(chainIndex, pixRow, pixCol)
            if pPixel <> hub75Bffrs.NO_PIXEL
                total += BYTE[pPixel]
    amountX10 := (total * TENTHS + morphColor.RAMP_MAX / HALF_DIVISOR) / morphColor.RAMP_MAX

PRI placeAt(row, column, digitValue)
' Clear the area, place the digit fresh showing digitValue, and draw it (one frame).
'
' @param row - the digit area's top row
' @param column - the digit area's left column
' @param digitValue - the digit to show (0 to 9, or digit.DIGIT_HIDDEN)

    clearArea(row, column)
    digit.placeDigit(row, column, segmentLength, thickness, digitValue, @mask, @ramp, tailX256)
    digit.setMotion(MOVE_MS, LINEAR_EASING)
    frame(0)                                                    ' the digit grows in (spec R-5.6) ...
    frame(MOVE_MS)                                              ' ... and rests

PRI frame(advanceMs)
' Advance the injected time and animate the digit once.
'
' @param advanceMs - milliseconds to advance the injected time

    nowMs += advanceMs
    digit.animate(nowMs)

PRI clearArea(row, column) | pixRow, pixCol, pPixel, idx
' Black the digit's area byte by byte through pixelAddressAtRC(), the same path areaSum() reads: the test's probe
' stays independent of the drawing path it checks (no driver fill and no digit drawing).
'
' @param row - the digit area's top row
' @param column - the digit area's left column

' Local Variables:
' @local pixRow - the pixel row being cleared
' @local pixCol - the pixel column being cleared
' @local pPixel - the address of the pixel being cleared
' @local idx - the byte of the pixel being cleared

    repeat pixRow from row to (row + areaHeight - morphMask.LAST_OFFSET) <# (maxRows - morphMask.LAST_OFFSET)
        repeat pixCol from column to (column + areaWidth - morphMask.LAST_OFFSET) <# (maxColumns - morphMask.LAST_OFFSET)
            pPixel := pixels.pixelAddressAtRC(chainIndex, pixRow, pixCol)
            if pPixel <> hub75Bffrs.NO_PIXEL
                idx := 0
                repeat hub75Bffrs.bytesPerColor(chainIndex)
                    BYTE[pPixel][idx++] := 0

PRI areaSum(row, column) : checksum
' Compute the checksum of the digit's area (clipped to the display).
'
' @param row - the digit area's top row
' @param column - the digit area's left column
' @returns checksum - the checksum: equal areas give equal sums

    checksum := probe.areaChecksum(chainIndex, column, row, areaWidth, areaHeight)

CON ' ---- License ----

