# local reference copy of the HUB75 driver (never committed)
REF-NO-COMMIT/

# HUB75 driver files are copied into Src/ for building but never versioned here.
# Users download the driver and copy this display's files over it.
# Our files MUST be named isp_hub75_morph*.spin2 or demo_hub75_morphSeg.spin2.
Src/*.spin2
!Src/isp_hub75_morph*.spin2
!Src/demo_hub75_morphSeg.spin2
# compiler outputs
Src/*.bin
Src/*.lst
Src/*.map
Src/*.obj

# our working records (plans and their archive, spec, analyses) are written for us, not
# for someone using the library, so they are never versioned
Docs/plans/
Docs/analysis/
Docs/SPECIFICATION.md

# bench run logs
Src/logs/
