CON ' ---- Test constants ----
  TEST_BUF_SIZE = 512

OBJ ' ---- Objects ----
  child : "isp_hub75_morphChild"

DAT ' ---- Buffers ----
testBuf byte 0[512]

PUB go() | status
'' Run the fixture test.
''

' Local Variables:
' @local status - fetched status

  status := child.CHILD_VALUE
  bytefill(@testBuf, 0, TEST_BUF_SIZE)
  child.evaluateSingleValue(status, @"check", child.CHILD_VALUE)

